<script>
(function(){
  function openPage(id){
    document.querySelectorAll('.page-view').forEach(function(p){
      p.classList.remove('active');
      p.style.setProperty('display','none','important');
    });
    const target=document.getElementById(id);
    if(target){
      target.classList.add('active');
      target.style.setProperty('display','block','important');
    }
    window.scrollTo(0,0);
  }

  function enhanceSurveyJobLinks(){
    const page=document.getElementById('survey-requests-page');
    if(!page)return;

    const rows=page.querySelectorAll('.survey-row:not(.head)');
    rows.forEach(function(row){
      const cells=[...row.children];
      const cell=cells.find(function(c){return /JOB-\d+/i.test(c.textContent.trim())});
      if(!cell || cell.querySelector('.survey-job-link'))return;

      const match=cell.textContent.match(/JOB-\d+/i);
      if(!match)return;

      const no=match[0].toUpperCase();
      const link=document.createElement('a');
      link.href='#';
      link.className='survey-job-link';
      link.dataset.job=no;
      link.textContent=no;

      cell.innerHTML='';
      cell.appendChild(link);
    });
  }

  enhanceSurveyJobLinks();

  document.addEventListener('click',function(e){
    const link=e.target.closest('#survey-requests-page .survey-job-link');
    if(!link)return;

    e.preventDefault();
    e.stopPropagation();

    const no=link.dataset.job;
    const row=link.closest('.survey-row');
    const cells=row ? [...row.children] : [];
    const addressCell=cells.find(function(c){
      const s=c.textContent.trim();
      return /\d+/.test(s) && /(?:street|st\b|ave\b|avenue|road|rd\b|drive|dr\b|blvd|lane|ln\b)/i.test(s);
    });
    const address=addressCell ? addressCell.textContent.trim() : '';

    window.__activeJob={no:no,address:address};

    const jobContext=document.getElementById('jobClientsContextJob');
    const addressContext=document.getElementById('jobClientsContextAddress');
    if(jobContext)jobContext.textContent=no;
    if(addressContext)addressContext.textContent=address || '—';

    openPage('job-clients-page');
  });

  // Re-enhance if Survey Requests is rendered again by legacy routing.
  const observer=new MutationObserver(function(){
    if(document.getElementById('survey-requests-page')?.classList.contains('active')){
      enhanceSurveyJobLinks();
    }
  });
  document.querySelectorAll('.page-view').forEach(function(p){
    observer.observe(p,{attributes:true,attributeFilter:['class']});
  });
})();
</script>


