<script id="survey-client-picker-definitive-fix">
(function(){
  const clients=[
    {name:'Consumer Company',email:'consumer.cl@mail.com'},
    {name:'QA Tester 3',email:'revew59089@playboot.com'},
    {name:'QA Tester 2',email:'pimebo9836@playboot.com'},
    {name:'No Access Company',email:'yihiser358@joystill.com'}
  ];

  const initials=n=>n.split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase();

  function render(q=''){
    const box=document.getElementById('srClientOptions');
    const empty=document.getElementById('srClientEmpty');
    if(!box)return;
    q=q.trim().toLowerCase();
    const filtered=clients.filter(c=>
      !q || c.name.toLowerCase().includes(q) || c.email.toLowerCase().includes(q)
    );
    box.innerHTML='';
    filtered.forEach(c=>{
      const b=document.createElement('button');
      b.type='button';
      b.className='sr-client-option crm-client-option';
      b.dataset.client=c.name;
      b.innerHTML='<span class="sr-client-avatar">'+initials(c.name)+'</span>'+
                  '<span class="sr-client-copy"><b>'+c.name+'</b><small>'+c.email+'</small></span>';
      box.appendChild(b);
    });
    if(empty) empty.style.display=filtered.length?'none':'block';
  }

  function setup(){
    const trigger=document.getElementById('srClientTrigger');
    const menu=document.getElementById('srClientMenu');
    const search=document.getElementById('srClientSearch');
    if(!trigger||!menu)return;

    render('');

    // Replace trigger to strip conflicting legacy listeners.
    const fresh=trigger.cloneNode(true);
    trigger.replaceWith(fresh);
    fresh.addEventListener('click',e=>{
      e.preventDefault();
      e.stopPropagation();
      const opening=!menu.classList.contains('open');
      menu.classList.toggle('open',opening);
      if(opening){
        render('');
        if(search){search.value='';setTimeout(()=>search.focus(),0)}
      }
    });

    if(search){
      const freshSearch=search.cloneNode(true);
      search.replaceWith(freshSearch);
      freshSearch.addEventListener('input',e=>render(e.target.value));
      freshSearch.addEventListener('click',e=>e.stopPropagation());
    }

    menu.addEventListener('click',e=>{
      e.stopPropagation();
      const opt=e.target.closest('.crm-client-option');
      if(!opt)return;
      const name=opt.dataset.client;
      const text=document.getElementById('srClientText');
      const hidden=document.getElementById('surveyRequestClient');
      if(text){text.textContent=name;text.classList.remove('placeholder')}
      if(hidden)hidden.value=name;
      menu.classList.remove('open');
    },true);

    document.addEventListener('click',e=>{
      if(!e.target.closest('#srClientPicker')) menu.classList.remove('open');
    });
  }

  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',setup);
  else setup();
})();
</script>























