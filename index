<script id="restored-job-management-flow">
(function(){
  const jobPages={
    'jobs-page':'jobs',
    'job-clients-page':'jobs',
    'job-details-page':'jobs',
    'new-job-page':'jobs',
    'survey-requests-page':'survey',
    'new-survey-request-page':'survey',
    'alta-nsps-intake-page':'alta',
    'alta-view-page':'alta',
    'alta-edit-page':'alta',
    'quotes-page':'quotes',
    'view-quote-page':'quotes',
    'create-quote-page':'quotes',
    'edit-quote-page':'quotes'
  };

  function syncNavigation(pageId){
    const section=jobPages[pageId];
    document.querySelectorAll('.side .nav,.side .page-link,.side .subnav a').forEach(function(item){
      item.classList.remove('active','selected','subnav-active','job-page-selected');
      item.removeAttribute('aria-current');
    });

    if(!section){
      const simple=pageId==='dashboard-page'?'dashboard':pageId==='crm-page'?'crm':'';
      const link=simple?document.querySelector('.page-link[data-page="'+simple+'"]'):null;
      if(link){
        link.classList.add('active','selected');
        link.setAttribute('aria-current','page');
      }
      return;
    }

    const selector={jobs:'.job-jobs-link',survey:'.job-survey-requests-link',alta:'.job-alta-intake-link',quotes:'.job-quotes-link'}[section];
    const link=document.querySelector(selector);
    const sub=link?.closest('.subnav');
    const parent=sub?.previousElementSibling;
    if(link){
      link.classList.add('subnav-active','job-page-selected');
      link.setAttribute('aria-current','page');
    }
    if(sub){
      sub.classList.add('open');
      sub.style.setProperty('display','block','important');
    }
    if(parent)parent.classList.add('open');
  }

  function openPage(pageId){
    const target=document.getElementById(pageId);
    if(!target)return;
    document.querySelectorAll('.page-view').forEach(function(page){
      page.classList.remove('active');
      page.style.setProperty('display','none','important');
    });
    target.classList.add('active');
    target.style.setProperty('display','block','important');
    syncNavigation(pageId);
    window.scrollTo(0,0);
  }

  function activePage(){
    return [...document.querySelectorAll('.page-view')].find(function(page){
      return page.classList.contains('active');
    });
  }

  function repairActivePage(){
    const page=activePage();
    if(!page)return;
    document.querySelectorAll('.page-view').forEach(function(candidate){
      candidate.style.setProperty('display',candidate===page?'block':'none','important');
    });
    syncNavigation(page.id);
  }

  function bind(selector,handler){
    document.querySelectorAll(selector).forEach(function(element){
      element.addEventListener('click',handler,true);
    });
  }

  bind('.job-jobs-link',function(e){
    e.preventDefault();
    e.stopImmediatePropagation();
    openPage('jobs-page');
  });
  bind('.job-survey-requests-link',function(e){
    e.preventDefault();
    e.stopImmediatePropagation();
    openPage('survey-requests-page');
  });
  bind('.job-alta-intake-link',function(e){
    e.preventDefault();
    e.stopImmediatePropagation();
    openPage('alta-nsps-intake-page');
  });
  bind('.job-quotes-link',function(e){
    e.preventDefault();
    e.stopImmediatePropagation();
    openPage('quotes-page');
  });

  bind('#jobClientsBack',function(e){
    e.preventDefault();e.stopImmediatePropagation();openPage('jobs-page');
  });
  bind('#jobDetailsBack',function(e){
    e.preventDefault();e.stopImmediatePropagation();openPage('job-clients-page');
  });
  bind('#backToSurveyRequests,#cancelSurveyRequest',function(e){
    e.preventDefault();e.stopImmediatePropagation();openPage('survey-requests-page');
