<script id="jobs-inline-clients-flow">
(function(){
  const jobsPage=document.getElementById('jobs-page');
  if(!jobsPage)return;

  function closeAccordion(accordion){
    if(!accordion)return;
    accordion.classList.remove('open');
    accordion.setAttribute('aria-hidden','true');
    const row=accordion.previousElementSibling;
    row?.classList.remove('expanded');
    const toggle=row?.querySelector('.jobs-accordion-toggle');
    toggle?.setAttribute('aria-expanded','false');
  }

  function toggleJobRow(row){
    const accordion=row?.nextElementSibling?.classList.contains('job-clients-accordion')?row.nextElementSibling:null;
    const toggle=row?.querySelector('.jobs-accordion-toggle');
    const shouldOpen=!accordion?.classList.contains('open');
    jobsPage.querySelectorAll('.job-clients-accordion.open').forEach(closeAccordion);
    if(shouldOpen&&accordion){
      accordion.classList.add('open');
      accordion.setAttribute('aria-hidden','false');
      row.classList.add('expanded');
      toggle?.setAttribute('aria-expanded','true');
    }
  }

  function openJobDetails(clientButton){
    const accordion=clientButton.closest('.job-clients-accordion');
    const jobRow=accordion?.previousElementSibling;
    const jobNo=accordion?.dataset.job||jobRow?.querySelector('.jobs-number')?.textContent.trim()||'';
    const address=jobRow?.children[1]?.textContent.trim()||'';
    const status=jobRow?.querySelector('.jobs-status')?.textContent.trim()||'Active';
    const client=clientButton.dataset.client||'Client';
    const email=clientButton.dataset.email||'';
    window.__activeJob={no:jobNo,address:address};
    window.__jobDetailsFromAccordion=true;
    const set=function(id,value){const el=document.getElementById(id);if(el)el.textContent=value;};
    set('detailJobNo',jobNo);
    set('detailOverviewJob',jobNo);
    set('detailJobAddress',address);
    set('detailPropertyRow',address);
    set('detailPropertyHeading',address);
    set('detailClientName',client);
    set('detailClientEmail',email);
    const statusPill=document.querySelector('#job-details-page .jd-status');
    if(statusPill)statusPill.textContent=status;
    if(typeof window.jobManagementRoute==='function')window.jobManagementRoute('job-details-page');
    else{
      document.querySelectorAll('.page-view').forEach(function(page){page.classList.remove('active');page.style.setProperty('display','none','important');});
      const details=document.getElementById('job-details-page');
      details?.classList.add('active');
      details?.style.setProperty('display','block','important');
      window.scrollTo(0,0);
    }
  }

  jobsPage.addEventListener('click',function(event){
    const createRequest=event.target.closest('.jobs-create-request');
    if(createRequest){
      event.preventDefault();
      event.stopImmediatePropagation();
      const row=createRequest.closest('.jobs-row');
      const jobNo=row?.querySelector('.jobs-number')?.textContent.trim()||'';
      const address=row?.children[1]?.textContent.trim()||'';
      window.__surveyRequestFromJob=true;
      window.__surveyRequestJobNo=jobNo;
      window.__activeJob={no:jobNo,address:address};
      const form=document.getElementById('new-survey-request-page');
      form?.classList.add('from-job');
      if(typeof window.jobManagementRoute==='function')window.jobManagementRoute('new-survey-request-page');
      return;
    }
    const toggle=event.target.closest('.jobs-accordion-toggle');
    if(toggle){
      event.preventDefault();
      event.stopImmediatePropagation();
      toggleJobRow(toggle.closest('.jobs-row'));
      return;
    }
    const client=event.target.closest('.job-inline-client');
    if(client){
      event.preventDefault();
      event.stopImmediatePropagation();
      openJobDetails(client);
      return;
    }
    const row=event.target.closest('.jobs-row:not(.jobs-head)');
    if(row&&!event.target.closest('button,a,input,select')){
      event.preventDefault();
      event.stopImmediatePropagation();
      toggleJobRow(row);
    }
  },true);

  document.addEventListener('click',function(event){
    const link=event.target.closest('#survey-requests-page .survey-job-link,#survey-requests-page .survey-row:not(.head)>div:first-child b');
    if(!link)return;
    const jobNo=(link.dataset.job||link.textContent||'').trim().toUpperCase();
    const accordion=[...jobsPage.querySelectorAll('.job-clients-accordion')].find(function(item){return item.dataset.job===jobNo;});
    if(!accordion)return;
    event.preventDefault();
    event.stopImmediatePropagation();
    jobsPage.querySelectorAll('.job-clients-accordion.open').forEach(closeAccordion);
    const row=accordion.previousElementSibling;
    accordion.classList.add('open');
    accordion.setAttribute('aria-hidden','false');
    row?.classList.add('expanded');
    row?.querySelector('.jobs-accordion-toggle')?.setAttribute('aria-expanded','true');
    if(typeof window.jobManagementRoute==='function')window.jobManagementRoute('jobs-page');
    else{
      document.querySelectorAll('.page-view').forEach(function(page){page.classList.remove('active');page.style.setProperty('display','none','important');});
      jobsPage.classList.add('active');
      jobsPage.style.setProperty('display','block','important');
      window.scrollTo(0,0);
    }
    setTimeout(function(){row?.scrollIntoView({block:'center'});},0);
  },true);
})();
</script>

<script id="new-job-modal-flow">
(function(){
  const page=document.getElementById('new-job-page');
  const openButton=document.querySelector('#jobs-page .jobs-new-job-btn');
  const createButton=document.getElementById('newJobCreate');
  const addClientButton=document.getElementById('newJobAddClient');
  const numberField=document.getElementById('newJobNumber');
  const duplicateError=document.getElementById('newJobDuplicateError');
  const clearPropertyButton=document.getElementById('newJobClearProperty');
  const saveClientButton=document.getElementById('saveClientModal');
  const tabs=[...document.querySelectorAll('[data-new-job-location]')];
  if(!page||!openButton)return;
  let mode='address';
  const clientEmails={'Consumer Company':'contact@consumercompany.com','QA Tester 3':'qa.tester3@example.com','No Access Company':'contact@noaccesscompany.com','James Lee':'james@zenatech.com'};
  const escapeHtml=function(value){return String(value||'').replace(/[&<>"']/g,function(char){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char];});};
  const normalizeLocation=function(value){return String(value||'').toLowerCase().replace(/\b(street)\b/g,'st').replace(/\b(avenue)\b/g,'ave').replace(/\b(road)\b/g,'rd').replace(/[^a-z0-9.-]+/g,' ').trim();};

  function duplicateJobs(){
    const rows=[...document.querySelectorAll('#jobs-page .jobs-row:not(.jobs-head)')];
    if(mode==='coordinates'){
      const lat=document.getElementById('newJobLatitude').value.trim(),lng=document.getElementById('newJobLongitude').value.trim();
      if(!lat||!lng)return [];
      const entered=normalizeLocation('Coordinates: '+lat+', '+lng);
      return rows.filter(function(row){return normalizeLocation(row.children[1]?.textContent)===entered;}).map(function(row){return row.querySelector('.jobs-number')?.textContent.trim();}).filter(Boolean);
    }
    const street=normalizeLocation(document.getElementById('newJobStreet').value);
    if(!street)return [];
    return rows.filter(function(row){const existing=normalizeLocation((row.children[1]?.textContent||'').split(',')[0]);return existing===street;}).map(function(row){return row.querySelector('.jobs-number')?.textContent.trim();}).filter(Boolean);
  }
  function requiredLocationComplete(){
    const ids=mode==='address'?['newJobStreet','newJobCity','newJobState','newJobCountry','newJobPostal']:['newJobLatitude','newJobLongitude'];
    return ids.every(function(id){return Boolean(document.getElementById(id)?.value.trim());});
  }
  function propertyHasValue(){
    return ['newJobStreet','newJobCity','newJobState','newJobCountry','newJobPostal','newJobLatitude','newJobLongitude'].some(function(id){return Boolean(document.getElementById(id)?.value.trim());});
  }
  function validateUniqueLocation(){
    const jobs=[...new Set(duplicateJobs())],duplicate=jobs.length>0;
    const disabled=duplicate||!requiredLocationComplete();
    createButton.disabled=disabled;
    createButton.setAttribute('aria-disabled',String(disabled));
    if(clearPropertyButton)clearPropertyButton.disabled=!propertyHasValue();
    if(duplicateError){duplicateError.textContent=duplicate?'This property already has a job assigned ('+jobs.join(', ')+'). Enter a different address or open the existing job.':'';duplicateError.classList.toggle('show',duplicate);}
    return !duplicate;
  }
  function updateClientSaveState(){
    if(!saveClientButton)return;
    const clientModal=document.getElementById('addClientModal');
    const complete=[...clientModal.querySelectorAll('input[required]')].every(function(field){return Boolean(field.value.trim());});
    saveClientButton.disabled=!complete;
    saveClientButton.setAttribute('aria-disabled',String(!complete));
  }
  function clearSubjectProperty(){
    ['newJobStreet','newJobCity','newJobState','newJobPostal','newJobLatitude','newJobLongitude'].forEach(function(id){const field=document.getElementById(id);if(field){field.value='';field.classList.remove('invalid');}});
    document.getElementById('newJobCountry').value='';
    validateUniqueLocation();
    const focusId=mode==='coordinates'?'newJobLatitude':'newJobStreet';
    document.getElementById(focusId)?.focus();
  }

  function nextJobNumber(){
    const values=[...document.querySelectorAll('#jobs-page .jobs-number')].map(function(item){const match=item.textContent.match(/(\d+)/);return match?Number(match[1]):0;});
    return 'JOB-'+(Math.max(0,...values)+1);
  }
  function setMode(nextMode){
    mode=nextMode;
    tabs.forEach(function(tab){const selected=tab.dataset.newJobLocation===mode;tab.classList.toggle('active',selected);tab.setAttribute('aria-selected',String(selected));});
    document.querySelectorAll('[data-new-job-panel]').forEach(function(panel){panel.classList.toggle('active',panel.dataset.newJobPanel===mode);});
    page.querySelectorAll('.invalid').forEach(function(field){field.classList.remove('invalid');});
    validateUniqueLocation();
  }
  function resetForm(){
    numberField.value=nextJobNumber();
    ['newJobStreet','newJobCity','newJobState','newJobPostal','newJobLatitude','newJobLongitude'].forEach(function(id){const field=document.getElementById(id);if(field)field.value='';});
    document.getElementById('newJobCountry').value='';
    document.getElementById('newJobClient').value='';
    const notice=document.getElementById('newJobClientNotice');if(notice){notice.textContent='';notice.classList.remove('show');}
    setMode('address');
    validateUniqueLocation();
  }
  function openPage(){resetForm();if(typeof window.jobManagementRoute==='function')window.jobManagementRoute('new-job-page');else{document.querySelectorAll('.page-view').forEach(function(item){item.classList.remove('active');item.style.setProperty('display','none','important');});page.classList.add('active');page.style.setProperty('display','block','important');window.scrollTo(0,0);}setTimeout(function(){document.getElementById('newJobStreet')?.focus();},0);}
  function openAddClientPopup(){
    window.__addClientFromNewJob=true;
    const clientModal=document.getElementById('addClientModal');
    if(!clientModal)return;
    clientModal.querySelectorAll('input').forEach(function(field){if(field.type==='checkbox')field.checked=true;else field.value='';field.classList.remove('invalid');});
    clientModal.querySelectorAll('textarea').forEach(function(field){field.value='';});
    clientModal.querySelectorAll('select').forEach(function(field){field.selectedIndex=0;field.classList.remove('invalid');});
    updateClientSaveState();
    clientModal.classList.add('open','from-new-job');
    clientModal.style.setProperty('display','flex','important');
    document.body.style.overflow='hidden';
    setTimeout(function(){document.getElementById('newJobClientCompany')?.focus();},0);
  }
  function closeClientPopup(returnToJob){
    const clientModal=document.getElementById('addClientModal');
    clientModal?.classList.remove('open','from-new-job');
    clientModal?.style.setProperty('display','none','important');
    window.__addClientFromNewJob=false;
    document.body.style.removeProperty('overflow');
    if(returnToJob)setTimeout(function(){document.getElementById('newJobClient')?.focus();},0);
  }
  function createClientFromPopup(event){
    if(!window.__addClientFromNewJob)return;
    event.preventDefault();
    event.stopImmediatePropagation();
    const clientModal=document.getElementById('addClientModal');
    const required=[...clientModal.querySelectorAll('input[required]')];
    required.forEach(function(field){field.classList.toggle('invalid',!field.value.trim());});
    const missing=required.find(function(field){return !field.value.trim();});
    if(missing){missing.focus();return;}
    const nameField=document.getElementById('newJobClientCompany');
    const name=nameField?.value.trim()||'';
    if(!name){nameField?.classList.add('invalid');nameField?.focus();return;}
    const email=document.getElementById('newJobClientEmail')?.value.trim()||'';
    clientEmails[name]=email;
    const select=document.getElementById('newJobClient');
    let option=[...select.options].find(function(item){return item.value===name;});
    if(!option){option=document.createElement('option');option.value=name;option.textContent=name;select.appendChild(option);}
    select.value=name;
    const notice=document.getElementById('newJobClientNotice');if(notice){notice.textContent=name+' was created and selected for this job.';notice.classList.add('show');}
    closeClientPopup(true);
  }
  function requireFields(ids){
    const missing=ids.map(function(id){return document.getElementById(id);}).filter(function(field){field?.classList.remove('invalid');return !field?.value.trim();});
    missing.forEach(function(field){field.classList.add('invalid');});
    missing[0]?.focus();
    return missing.length===0;
  }
  function createJob(){
    if(!validateUniqueLocation())return;
    const valid=mode==='address'
      ?requireFields(['newJobStreet','newJobCity','newJobState','newJobCountry','newJobPostal'])
      :requireFields(['newJobLatitude','newJobLongitude']);
    if(!valid)return;
    const jobNo=numberField.value;
    const client=document.getElementById('newJobClient').value;
    const email=clientEmails[client]||'';
    const address=mode==='address'
      ?[document.getElementById('newJobStreet').value.trim(),document.getElementById('newJobCity').value.trim(),document.getElementById('newJobState').value.trim(),document.getElementById('newJobPostal').value.trim(),document.getElementById('newJobCountry').value].filter(Boolean).join(', ')
      :'Coordinates: '+document.getElementById('newJobLatitude').value.trim()+', '+document.getElementById('newJobLongitude').value.trim();
    const clientContent=client
      ?'<button class="job-client-inline-row job-inline-client" type="button" data-client="'+escapeHtml(client)+'" data-email="'+escapeHtml(email)+'"><span class="job-client-person"><span class="job-client-avatar">'+escapeHtml(client.charAt(0).toUpperCase())+'</span><b>'+escapeHtml(client)+'</b></span><span>'+escapeHtml(email)+'</span><span><em class="job-client-status">Active</em></span><span class="job-inline-arrow"><svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg></span></button>'
      :'<div class="job-inline-empty">No client is assigned to this job yet.</div>';
    const markup='<div class="jobs-row" data-status="Active"><div class="jobs-number">'+escapeHtml(jobNo)+'</div><div>'+escapeHtml(address)+'</div><div><span class="jobs-status active">Active</span></div><div class="jobs-actions"><button class="jobs-accordion-toggle" type="button" aria-expanded="true" aria-label="Show clients for '+escapeHtml(jobNo)+'">›</button><button class="jobs-create-request">Create Request</button></div></div><div class="job-clients-accordion" data-job="'+escapeHtml(jobNo)+'" aria-hidden="false"><div class="job-clients-inline-table"><div class="job-client-inline-row inline-head head"><div>Client</div><div>Email</div><div>Status</div><div></div></div>'+clientContent+'</div></div>';
    const table=document.querySelector('#jobs-page .jobs-table');
    table?.querySelectorAll('.job-clients-accordion.open').forEach(function(item){item.classList.remove('open');item.setAttribute('aria-hidden','true');item.previousElementSibling?.classList.remove('expanded');item.previousElementSibling?.querySelector('.jobs-accordion-toggle')?.setAttribute('aria-expanded','false');});
    table?.insertAdjacentHTML('beforeend',markup);
    const accordion=table?.querySelector('.job-clients-accordion[data-job="'+jobNo+'"]');
    const row=accordion?.previousElementSibling;
    accordion?.classList.add('open');row?.classList.add('expanded');
    if(typeof window.jobManagementRoute==='function')window.jobManagementRoute('jobs-page');
    else{page.classList.remove('active');page.style.setProperty('display','none','important');const jobs=document.getElementById('jobs-page');jobs?.classList.add('active');jobs?.style.setProperty('display','block','important');}
    setTimeout(function(){row?.scrollIntoView({block:'center'});},0);
  }

  openButton.addEventListener('click',function(event){event.preventDefault();event.stopImmediatePropagation();openPage();},true);
  addClientButton?.addEventListener('click',function(event){event.preventDefault();event.stopImmediatePropagation();openAddClientPopup();},true);
  document.getElementById('saveClientModal')?.addEventListener('click',createClientFromPopup,true);
  ['closeClientModal','cancelClientModal'].forEach(function(id){document.getElementById(id)?.addEventListener('click',function(event){if(!window.__addClientFromNewJob)return;event.preventDefault();event.stopImmediatePropagation();closeClientPopup(true);},true);});
  document.getElementById('addClientModal')?.addEventListener('click',function(event){if(window.__addClientFromNewJob&&event.target===event.currentTarget){event.preventDefault();event.stopImmediatePropagation();closeClientPopup(true);}},true);
  tabs.forEach(function(tab){tab.addEventListener('click',function(){setMode(tab.dataset.newJobLocation);});});
  document.getElementById('newJobClearProperty')?.addEventListener('click',clearSubjectProperty);
  ['newJobStreet','newJobCity','newJobState','newJobCountry','newJobPostal','newJobLatitude','newJobLongitude'].forEach(function(id){const field=document.getElementById(id);field?.addEventListener('input',validateUniqueLocation);field?.addEventListener('change',validateUniqueLocation);});
  document.querySelectorAll('#addClientModal input[required]').forEach(function(field){field.addEventListener('input',updateClientSaveState);field.addEventListener('change',updateClientSaveState);});
  createButton.addEventListener('click',createJob);
})();
</script>

<script id="shared-back-navigation">
(function(){
  const backSelector=[
    '#jobClientsBack','#jobDetailsBack','#surveyViewBack','#backToSurveyRequests',
    '#vqBack','#backToQuotes','#edit-backToQuotes','#backFromViewClient',
    '#backFromEditClient','#backToClients','[data-client-back]',
    '#cancelCreateQuote','#edit-cancelCreateQuote',
    '#cancelAddClientPage','#newJobBack'
  ].join(',');
  const jobPages=new Set([
    'jobs-page','job-clients-page','job-details-page','new-job-page','survey-requests-page',
    'new-survey-request-page','view-survey-request-page','alta-nsps-intake-page','alta-view-page','alta-edit-page','quotes-page',
    'view-quote-page','create-quote-page','edit-quote-page'
  ]);
  const crmPages=new Set(['crm-page','view-client-page','edit-client-page','add-client-page']);
  const activePage=function(){return [...document.querySelectorAll('.page-view')].find(function(page){return page.classList.contains('active');});};
  const history=[];
  let suppressTarget='';

  function setTopNavigation(pageId){
    document.querySelectorAll('.side .nav,.side .page-link,.side .subnav a').forEach(function(item){
      item.classList.remove('active','selected','subnav-active','job-page-selected');
      item.removeAttribute('aria-current');
    });
    const name=crmPages.has(pageId)?'crm':pageId==='dashboard-page'?'dashboard':'';
    const link=name?document.querySelector('.page-link[data-page="'+name+'"]'):null;
    if(link){link.classList.add('active','selected');link.setAttribute('aria-current','page');}
  }

  function showPage(pageId){
    if(jobPages.has(pageId)&&typeof window.jobManagementRoute==='function'){
      window.jobManagementRoute(pageId);
      return;
    }
    document.querySelectorAll('.page-view').forEach(function(page){
      page.classList.remove('active');
      page.style.setProperty('display','none','important');
    });
    const target=document.getElementById(pageId);
    if(target){target.classList.add('active');target.style.setProperty('display','block','important');}
    setTopNavigation(pageId);
    window.scrollTo(0,0);
  }

  function recordActive(){
    const id=activePage()?.id;
    if(!id)return;
    if(suppressTarget===id){suppressTarget='';return;}
    if(history[history.length-1]!==id)history.push(id);
  }

  document.querySelectorAll(backSelector).forEach(function(button){button.textContent='← Back';button.setAttribute('aria-label','Go back to previous page');});
  recordActive();
  new MutationObserver(recordActive).observe(document.body,{subtree:true,attributes:true,attributeFilter:['class','style']});

  document.addEventListener('pointerdown',function(event){
    const trigger=event.target.closest('#survey-requests-page .create-from-request,#view-survey-request-page #surveyViewPrimary');
    if(!trigger)return;
    window.__quoteBackOrigin=document.getElementById('view-survey-request-page')?.classList.contains('active')
      ?'view-survey-request-page':'survey-requests-page';
  },true);

  document.addEventListener('click',function(event){
    const quoteTrigger=event.target.closest('#survey-requests-page .create-from-request,#view-survey-request-page #surveyViewPrimary');
    if(quoteTrigger){
      const source=activePage()?.id;
      if(source==='survey-requests-page'||source==='view-survey-request-page')window.__quoteBackOrigin=source;
    }
    const back=event.target.closest(backSelector);
    if(!back)return;
    event.preventDefault();
    event.stopImmediatePropagation();
    const current=activePage()?.id;
    if(current&&history[history.length-1]!==current)history.push(current);
    const quoteOrigin=back.matches('#backToQuotes,#cancelCreateQuote')&&current==='create-quote-page'
      &&(window.__quoteBackOrigin==='survey-requests-page'||window.__quoteBackOrigin==='view-survey-request-page')
      ?window.__quoteBackOrigin:'';
    let target;
    if(quoteOrigin){
      const originIndex=history.lastIndexOf(quoteOrigin);
      if(originIndex>=0)history.splice(originIndex+1);
      else history.push(quoteOrigin);
      target=quoteOrigin;
      window.__quoteBackOrigin='';
    }else{
