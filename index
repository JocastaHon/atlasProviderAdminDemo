<script>
(function(){
  let selectedJob={no:'JOB-102',address:'123 Main Street, Austin, TX 78701'};

  function go(id){
    document.querySelectorAll('.page-view').forEach(p=>{
      p.classList.remove('active');
      p.style.removeProperty('display');
    });
    const page=document.getElementById(id);
    if(page) page.classList.add('active');
    window.scrollTo(0,0);
  }

  // Jobs -> associated Clients
  document.querySelectorAll('#jobs-page .jobs-row:not(.jobs-head)').forEach(row=>{
    const view=row.querySelector('.jobs-icon[title="View job"]');
    if(!view)return;
    view.onclick=function(e){
      e.preventDefault();
      e.stopPropagation();
      selectedJob={
        no:row.querySelector('.jobs-number')?.textContent.trim()||'',
        address:row.children[1]?.textContent.trim()||''
      };
      document.getElementById('jobClientsTitle').textContent=selectedJob.no;
      document.getElementById('jobClientsAddress').textContent=selectedJob.address;
      go('job-clients-page');
    };
  });

  // Clients -> Job Details
  document.querySelectorAll('#job-clients-page .job-client-view').forEach(btn=>{
    btn.onclick=function(e){
      e.preventDefault();
      document.getElementById('detailJobNo').textContent=selectedJob.no;
      document.getElementById('detailOverviewJob').textContent=selectedJob.no;
      document.getElementById('detailJobAddress').textContent=selectedJob.address;
      document.getElementById('detailPropertyRow').textContent=selectedJob.address;
      document.getElementById('detailPropertyHeading').textContent=selectedJob.address;
      document.getElementById('detailClientName').textContent=btn.dataset.client||'—';
      go('job-details-page');
    };
  });

  // Back navigation remains inside Jobs flow.
  document.getElementById('jobClientsBack')?.addEventListener('click',e=>{
    e.preventDefault();go('jobs-page');
  });
  document.getElementById('jobDetailsBack')?.addEventListener('click',e=>{
    e.preventDefault();go('job-clients-page');
  });

  // Never expose Job Details directly from other navigation.
  document.querySelectorAll('a,button').forEach(el=>{
    if(el.closest('#job-clients-page') || el.closest('#job-details-page') || el.closest('#jobs-page')) return;
    if(el.getAttribute('data-page')==='job-details' || el.getAttribute('href')==='#job-details-page'){
      el.removeAttribute('data-page');
      el.removeAttribute('href');
    }
  });
})();
</script>


<script>
(function(){
  function openPage(id){
    document.querySelectorAll('.page-view').forEach(function(p){
      p.classList.remove('active');
      p.style.removeProperty('display');
    });
    const target=document.getElementById(id);
    if(target){
      target.classList.add('active');
      target.style.setProperty('display','block','important');
    }
    window.scrollTo(0,0);
  }

  // Make every visible "Jobs" item under Job Management open the Jobs page.
  document.querySelectorAll('.subnav a, .subnav button').forEach(function(el){
    if(el.textContent.trim()==='Jobs'){
      el.addEventListener('click',function(e){
        e.preventDefault();
        e.stopImmediatePropagation();
        openPage('jobs-page');

        document.querySelectorAll('.subnav a').forEach(a=>a.classList.remove('job-page-selected','subnav-active'));
        el.classList.add('job-page-selected');

        const sub=el.closest('.subnav');
        if(sub){
          sub.classList.add('open');
          sub.previousElementSibling?.classList.add('open');
        }
      },true);
    }
  });

  // Re-wire Jobs eye buttons after all earlier scripts have loaded.
  document.querySelectorAll('#jobs-page .jobs-row:not(.jobs-head)').forEach(function(row){
    const eye=row.querySelector('.jobs-icon[title="View job"]');
    if(!eye)return;
    eye.addEventListener('click',function(e){
      e.preventDefault();
      e.stopImmediatePropagation();

      const no=row.querySelector('.jobs-number')?.textContent.trim()||'';
      const address=row.children[1]?.textContent.trim()||'';

      window.__activeJob={no:no,address:address};
      const title=document.getElementById('jobClientsTitle');
      const addr=document.getElementById('jobClientsAddress');
      if(title)title.textContent=no;
      if(addr)addr.textContent=address;

      openPage('job-clients-page');
    },true);
  });

  // Re-wire client arrows -> Job Details.
  document.querySelectorAll('#job-clients-page .job-client-arrow').forEach(function(btn){
    btn.addEventListener('click',function(e){
      e.preventDefault();
      e.stopImmediatePropagation();

      const job=window.__activeJob||{no:'JOB-102',address:'123 Main Street, Austin, TX 78701'};
      const set=(id,val)=>{const el=document.getElementById(id);if(el)el.textContent=val};

      set('detailJobNo',job.no);
      set('detailOverviewJob',job.no);
      set('detailJobAddress',job.address);
      set('detailPropertyRow',job.address);
      set('detailPropertyHeading',job.address);
      set('detailClientName',btn.dataset.client||'—');

      openPage('job-details-page');
    },true);
  });

  // Back buttons.
  document.getElementById('jobClientsBack')?.addEventListener('click',function(e){
    e.preventDefault();openPage('jobs-page');
  },true);
  document.getElementById('jobDetailsBack')?.addEventListener('click',function(e){
    e.preventDefault();openPage('job-clients-page');
  },true);
})();
</script>


<script>
(function(){
  function openDedicatedPage(id){
    document.querySelectorAll('.page-view').forEach(function(page){
      page.classList.remove('active');
      page.style.setProperty('display','none','important');
    });

    const target=document.getElementById(id);
    if(target){
      target.classList.add('active');
      target.style.setProperty('display','block','important');
    }
    window.scrollTo(0,0);
  }

  document.querySelectorAll('#jobs-page .jobs-create-request').forEach(function(btn){
    btn.addEventListener('click',function(e){
      e.preventDefault();
      e.stopImmediatePropagation();

      const row=btn.closest('.jobs-row');
      const jobNo=row?.querySelector('.jobs-number')?.textContent.trim()||'';
      const address=row?.children[1]?.textContent.trim()||'';

      window.__surveyRequestFromJob=true;
      window.__surveyRequestJobNo=jobNo;
      window.__activeJob={no:jobNo,address:address};

      openDedicatedPage('new-survey-request-page');

      // Preserve the existing "created from Job" locked/summary behavior.
      setTimeout(function(){
        const page=document.getElementById('new-survey-request-page');
        if(page) page.classList.add('from-job');

        const summaryJob=document.getElementById('summaryJobNumber');
        const summaryAddress=document.getElementById('summaryAddress');
        if(summaryJob) summaryJob.textContent=jobNo;
        if(summaryAddress) summaryAddress.textContent=address;
      },0);
    },true);
  });
})();
</script>


<script>
(function(){
  function returnToSurveyRequests(){
    window.__surveyRequestFromJob=false;
    window.__surveyRequestJobNo='';
    document.getElementById('new-survey-request-page')?.classList.remove('from-job');

    if(typeof window.openAppPage==='function'){
      window.openAppPage('survey-requests-page');
      return;
    }

    document.querySelectorAll('.page-view').forEach(function(page){
      page.classList.remove('active');
      page.style.setProperty('display','none','important');
    });

    const requests=document.getElementById('survey-requests-page');
    if(requests){
      requests.classList.add('active');
      requests.style.setProperty('display','block','important');
    }
    window.scrollTo(0,0);
  }

  const survey=document.getElementById('new-survey-request-page');
  if(!survey)return;

  // Back and Cancel always return to the Survey Requests list.
  survey.addEventListener('click',function(e){
    const control=e.target.closest('button,a');
    if(!control || !window.__surveyRequestFromJob)return;

    const label=control.textContent.trim().toLowerCase();
    const isBack=label.includes('back');
    const isCancel=label==='cancel';

    if(isBack || isCancel){
      e.preventDefault();
      e.stopImmediatePropagation();
      returnToSurveyRequests();
    }
  },true);
})();
</script>


<script>
(function(){
  window.openAppPage=function(id){
    document.querySelectorAll('.page-view').forEach(function(p){
      p.classList.remove('active');
      p.style.setProperty('display','none','important');
    });
    const target=document.getElementById(id);
    if(target){
      target.classList.add('active');
      target.style.setProperty('display','block','important');
    }
    window.scrollTo(0,0);
  };

  // Re-assert current page after any legacy handler runs.
  document.addEventListener('click',function(e){
    const jobsLink=[...document.querySelectorAll('.subnav a')].find(a=>a.textContent.trim()==='Jobs');
    if(jobsLink && (e.target===jobsLink || jobsLink.contains(e.target))){
      setTimeout(()=>window.openAppPage('jobs-page'),0);
    }
  },true);
})();
</script>


<script>
(function(){
  const routeMap={
    'Jobs':'jobs-page',
    'Survey Requests':'survey-requests-page',
    'ALTA/NSPS Intake':'alta-nsps-intake-page',
    'Quotes':'quotes-page'
  };

  function route(id){
    document.querySelectorAll('.page-view').forEach(p=>{
      p.classList.remove('active');
      p.style.setProperty('display','none','important');
    });

    const target=document.getElementById(id);
    if(target){
      target.classList.add('active');
      target.style.setProperty('display','block','important');
    }

    // Sync selected Job Management navigation item.
    document.querySelectorAll('.subnav a').forEach(a=>{
      a.classList.remove('job-page-selected','subnav-active');
    });

    let selected='';
    if(id==='jobs-page'||id==='job-clients-page'||id==='job-details-page'||id==='new-job-page') selected='Jobs';
    if(id==='survey-requests-page'||id==='new-survey-request-page') selected='Survey Requests';
    if(id==='alta-nsps-intake-page'||id==='alta-view-page'||id==='alta-edit-page') selected='ALTA/NSPS Intake';
    if(id==='quotes-page'||id==='create-quote-page') selected='Quotes';

    if(selected){
      const link=[...document.querySelectorAll('.subnav a')]
        .find(a=>a.textContent.trim()===selected);
      if(link){
        link.classList.add('job-page-selected');
        const sub=link.closest('.subnav');
        if(sub){
          sub.classList.add('open');
          sub.previousElementSibling?.classList.add('open');
        }
      }
    }
    window.scrollTo(0,0);
  }

  window.jobManagementRoute=route;

  // Sidebar routes: Jobs / Survey Requests / Quotes.
  document.querySelectorAll('.subnav a').forEach(link=>{
    const label=link.textContent.trim();
    if(!routeMap[label])return;

    link.addEventListener('click',e=>{
      e.preventDefault();
      e.stopImmediatePropagation();
      route(routeMap[label]);
    },true);
  });

  // Survey Requests -> Add New Survey Request.
  document.addEventListener('click',e=>{
    const el=e.target.closest('button,a');
    if(!el)return;
    const text=el.textContent.trim();

    if(text.includes('New Survey Request') && !el.closest('#new-survey-request-page')){
      e.preventDefault();
      e.stopImmediatePropagation();
      window.__surveyRequestFromJob=false;
      window.__surveyRequestJobNo='';
      const requestPage=document.getElementById('new-survey-request-page');
      if(requestPage){
        requestPage.classList.remove('from-job');
        [
          'refSurveyStreet','refSurveyCity','refSurveyState','refSurveyCountry',
          'refSurveyPostal','refSurveyLat','refSurveyLng','refJobSearch'
        ].forEach(function(id){
          const field=document.getElementById(id);
          if(!field)return;
          field.disabled=false;
          field.value='';
        });
        requestPage.querySelectorAll('.reference-location-tabs button').forEach(function(tab){
          tab.classList.toggle('active',tab.dataset.refLocation==='address');
        });
        document.getElementById('refAddressPanel')?.classList.add('active');
        document.getElementById('refCoordinatesPanel')?.classList.remove('active');
        const clientValue=document.getElementById('surveyRequestClient');
        const clientText=document.getElementById('srClientText');
        if(clientValue)clientValue.value='';
        if(clientText){clientText.textContent='Select client...';clientText.classList.add('placeholder');}
        const help=document.getElementById('refJobHelp');
        if(help){
          help.classList.remove('matched');
          help.textContent='Auto-fill from the property, or enter a Job # if you know it. If no existing job is found, a new Job # will be created automatically.';
        }
      }
      route('new-survey-request-page');
    }

    // Survey Request back/cancel returns to the page that launched the form.
    if(el.closest('#new-survey-request-page')){
      if(text.toLowerCase().includes('back') || text.toLowerCase()==='cancel'){
        e.preventDefault();
        e.stopImmediatePropagation();
        route(window.__surveyRequestFromJob?'jobs-page':'survey-requests-page');
        window.__surveyRequestFromJob=false;
      }
    }

    // Quote entry points.
    if((text==='Create Quote' || text.includes('New Quote')) && !el.closest('#create-quote-page') && !el.closest('.create-from-request,#jobDetailsCreateQuote')){
      e.preventDefault();
      e.stopImmediatePropagation();
      route('create-quote-page');
    }

    // Create Quote back/cancel returns to its originating survey page when applicable.
    if(el.closest('#create-quote-page') &&
       (text.toLowerCase().includes('back') || text.toLowerCase()==='cancel')){
      e.preventDefault();
      e.stopImmediatePropagation();
      route(window.__quoteBackOrigin||'quotes-page');
      window.__quoteBackOrigin='';
    }
  },true);
})();
</script>


<script>
