<script id="unified-quote-details-and-resources">
(function(){
  const catalog={
    delivery:['Client Portal','DWG/AutoCAD','Email Delivery','PDF Report','Printed Map'],
    equipment:['DJI Phantom 4 RTK','DJI Matrice 300','RTK GPS','Thermal Camera','LiDAR Sensor'],
    drones:['DJI Mavic 3 Enterprise','DJI Matrice 350 RTK','DJI Matrice 30T','Autel EVO II Enterprise']
  };
  const defaultPrices={
    delivery:{'Client Portal':0,'DWG/AutoCAD':0,'Email Delivery':0,'PDF Report':0,'Printed Map':0},
    equipment:{'DJI Phantom 4 RTK':250,'DJI Matrice 300':400,'RTK GPS':125,'Thermal Camera':175,'LiDAR Sensor':300},
    drones:{'DJI Mavic 3 Enterprise':200,'DJI Matrice 350 RTK':450,'DJI Matrice 30T':375,'Autel EVO II Enterprise':225}
  };
  const symbols={USD:'$',CAD:'CA$',EUR:'€',GBP:'£',AUD:'A$'};
  let activeRoot=null;
  let activeType='';

  function rootPrefix(root){return root.id==='edit-quote-page'?'edit-':'';}
  function hiddenFields(root){
    const edit=root.id==='edit-quote-page';
    const step1=root.querySelector(edit?'#edit-quoteStep1':'#quoteStep1');
    return {
      client:root.querySelector(edit?'#edit-quoteClientSelect':'#quoteClientSelect'),
      job:root.querySelector(edit?'#edit-quoteJobSelect':'#quoteJobSelect'),
      description:step1?.querySelector('textarea[placeholder^="Describe the requested service"]'),
      notes:step1?.querySelector('textarea[placeholder="Additional notes or special instructions..."]')
    };
  }
  function copyOptions(source,target){
    const current=target.value;
    target.innerHTML='';
    [...(source?.options||[])].forEach(function(option){const clone=document.createElement('option');clone.value=option.value;clone.textContent=option.textContent;target.appendChild(clone);});
    if([...target.options].some(function(option){return option.value===source?.value;}))target.value=source.value;
    else if(current)target.value=current;
  }
  function forceServicesOnly(root){
    root.querySelector('.quote-stepper')?.style.setProperty('display','none','important');
    root.querySelector('.quote-workflow-intro')?.style.setProperty('display','none','important');
    const step1=root.querySelector(root.id==='edit-quote-page'?'#edit-quoteStep1':'#quoteStep1');if(step1){step1.classList.remove('active');step1.style.setProperty('display','none','important');}
    const step2=root.querySelector(root.id==='edit-quote-page'?'#edit-quoteStep2':'#quoteStep2');if(step2){step2.classList.add('active');step2.style.setProperty('display','block','important');}
    root.querySelector(root.id==='edit-quote-page'?'#edit-quotePrevStep':'#quotePrevStep')?.style.setProperty('display','none','important');
  }

  window.buildUnifiedQuoteDetails=function(root,state,deferSync){
    if(!root)return;
    forceServicesOnly(root);
    let card=root.querySelector('.unified-quote-details');
    const old=root.querySelector('.edit-quote-context-summary');
    if(!card){
      card=old||document.createElement('section');
      card.className='unified-quote-details';
      card.innerHTML='<h2>Quote Details</h2><p class="detail-sub">Confirm the client and job context, then add the quote description.</p><div class="unified-quote-details-grid"><div class="unified-quote-field"><label>Client</label><select data-unified-field="client"></select></div><div class="unified-quote-field"><label>Job Number</label><select data-unified-field="job"></select></div><div class="unified-quote-field full"><label>Description</label><textarea data-unified-field="description" placeholder="Describe the requested service, scope, or client requirements..."></textarea></div></div>';
      if(!old)root.querySelector('.create-quote-head')?.insertAdjacentElement('afterend',card);
    }
    if(deferSync)return;
    const hidden=hiddenFields(root);
    const ui={client:card.querySelector('[data-unified-field="client"]'),job:card.querySelector('[data-unified-field="job"]'),description:card.querySelector('[data-unified-field="description"]')};
    copyOptions(hidden.client,ui.client);copyOptions(hidden.job,ui.job);
    ui.client.value=hidden.client?.value||state?.meta?.client||'';
    ui.job.value=hidden.job?.value||'';
    ui.description.value=hidden.description?.value||state?.meta?.description||'';
    ui.client.disabled=true;
    ui.job.disabled=true;
    if(card.dataset.bound!=='true'){
      card.dataset.bound='true';
      ui.client.addEventListener('change',function(){
        hidden.client.value=ui.client.value;hidden.client.dispatchEvent(new Event('change',{bubbles:true}));
        copyOptions(hidden.job,ui.job);ui.job.disabled=hidden.job.disabled;
      });
      ui.job.addEventListener('change',function(){
        let option=[...hidden.job.options].find(function(item){return item.value===ui.job.value;});
        if(!option){option=document.createElement('option');option.value=ui.job.value;option.textContent=ui.job.selectedOptions[0]?.textContent||ui.job.value;hidden.job.appendChild(option);}
        hidden.job.disabled=false;hidden.job.value=ui.job.value;hidden.job.dispatchEvent(new Event('change',{bubbles:true}));
      });
      ui.description.addEventListener('input',function(){if(hidden.description!==ui.description)hidden.description.value=ui.description.value;});
    }
    window.hydrateQuoteResourceCards(root,state);
  };

  function currency(root){
    const select=root.querySelector((root.id==='edit-quote-page'?'#edit-quoteStep2':'#quoteStep2')+' .currency-box select');
    const code=((select?.selectedOptions[0]?.textContent||'USD').match(/USD|CAD|EUR|GBP|AUD/)||['USD'])[0];
    return {code:code,symbol:symbols[code]};
  }
  function dataFor(root,state){
    if(!root.__quoteResourceData)root.__quoteResourceData={delivery:{},equipment:{},drones:{}};
    const prefix=rootPrefix(root);
    ['delivery','equipment','drones'].forEach(function(type){
      const data=root.__quoteResourceData[type];
      if(Object.keys(data).length)return;
      const savedPrices=state?.resourcePrices?.[type]||{};
      const selectedText=state?.resources?.[type]||root.querySelector('#'+prefix+type+'Selected')?.textContent||'';
      const names=selectedText && selectedText!=='None selected'?selectedText.split(',').map(function(name){return name.trim();}).filter(Boolean):[];
      names.forEach(function(name){data[name]=Number(savedPrices[name]??defaultPrices[type][name]??0);});
    });
    return root.__quoteResourceData;
  }
  function totalResources(root){
    const prefix=rootPrefix(root);const data=dataFor(root);let resourceGrand=0;
    ['delivery','equipment','drones'].forEach(function(type){
      const amount=Object.values(data[type]).reduce(function(sum,value){return sum+Number(value||0);},0);resourceGrand+=amount;
      const total=root.querySelector('#'+prefix+type+'Total');if(total)total.textContent=currency(root).symbol+amount.toFixed(2);
    });
    const providerText=root.querySelector('#'+prefix+'providerTotal')?.textContent||'';
    const provider=/pending/i.test(providerText)?0:Number(providerText.replace(/[^0-9.-]/g,''))||0;
    const grand=root.querySelector('#'+prefix+'grandTotal');if(grand)grand.textContent=currency(root).symbol+(provider+resourceGrand).toFixed(2);
  }
  function renderType(root,type){
    const prefix=rootPrefix(root);const data=dataFor(root)[type];const names=Object.keys(data);const c=currency(root);
    const selected=root.querySelector('#'+prefix+type+'Selected');const count=root.querySelector('#'+prefix+type+'Count');const card=selected?.closest('.quote-resource-card');if(!card)return;
    if(count)count.textContent='('+names.length+')';
    if(selected){selected.textContent=names.length?names.join(', '):'None selected';selected.style.setProperty('display',names.length?'none':'block','important');}
    let box=card.querySelector('.final-selected-fields');if(!box){box=document.createElement('div');box.className='final-selected-fields';card.appendChild(box);}
    box.style.display=names.length?'block':'none';
    box.innerHTML=names.length?'<div class="final-selected-head"><span>Selected</span><span>Price</span><span></span></div>'+names.map(function(name){return '<div class="final-selected-row" data-name="'+name.replace(/"/g,'&quot;')+'"><span>'+name+'</span><div class="final-price-field"><span>'+c.symbol+'</span><input type="number" min="0" step=".01" value="'+data[name]+'"></div><button type="button" class="final-selected-delete" title="Delete" aria-label="Remove '+name+'"><svg viewBox="0 0 24 24"><path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M7 7l1 13h8l1-13"/><path d="M10 11v5M14 11v5"/></svg></button></div>';}).join(''):'';
    box.querySelectorAll('.final-selected-row').forEach(function(row){
      const name=row.dataset.name;row.querySelector('input').addEventListener('input',function(){data[name]=Number(this.value||0);totalResources(root);});
      row.querySelector('.final-selected-delete').addEventListener('click',function(){delete data[name];renderType(root,type);totalResources(root);});
    });
    const button=card.querySelector('.resource-select');if(button)button.innerHTML='<span>Select</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4"/></svg>';
  }
  window.hydrateQuoteResourceCards=function(root,state){
    if(!root)return;
    if(state){
      const marker=state.meta?.id||JSON.stringify([state.meta?.client,state.meta?.description,state.resources,state.resourcePrices]);
      if(root.__quoteResourceMarker!==marker){root.__quoteResourceData={delivery:{},equipment:{},drones:{}};root.__quoteResourceMarker=marker;}
    }
    dataFor(root,state);['delivery','equipment','drones'].forEach(function(type){renderType(root,type);});totalResources(root);
  };

  const modal=document.getElementById('finalResourceModal');const options=document.getElementById('finalResourceOptions');const search=document.getElementById('finalResourceSearch');const selectAll=document.getElementById('finalSelectAll');
  function drawOptions(){
    if(!activeRoot||!activeType)return;const selected=dataFor(activeRoot)[activeType];const query=(search.value||'').toLowerCase();
    options.innerHTML=catalog[activeType].filter(function(name){return name.toLowerCase().includes(query);}).map(function(name){return '<label style="display:flex;gap:10px;align-items:center;padding:11px 3px;border-bottom:1px solid #eef1f4;font-size:12px;cursor:pointer"><input type="checkbox" value="'+name+'" '+(name in selected?'checked':'')+'> <span>'+name+'</span></label>';}).join('');
    selectAll.checked=!!options.querySelectorAll('input').length && [...options.querySelectorAll('input')].every(function(input){return input.checked;});
  }
  window.openQuoteResourcePicker=function(root,type){
    activeRoot=root;activeType=type;document.getElementById('finalResourceTitle').textContent=type==='delivery'?'Select delivery types':type==='equipment'?'Select equipment / tools':'Select drones / fleet';search.value='';drawOptions();modal.style.display='flex';
  };
  document.getElementById('finalResourceDone')?.addEventListener('click',function(e){
    if(!activeRoot)return;e.preventDefault();e.stopImmediatePropagation();const data=dataFor(activeRoot)[activeType];const chosen=[...options.querySelectorAll('input:checked')].map(function(input){return input.value;});Object.keys(data).forEach(function(name){if(!chosen.includes(name))delete data[name];});chosen.forEach(function(name){if(!(name in data))data[name]=defaultPrices[activeType][name]||0;});renderType(activeRoot,activeType);totalResources(activeRoot);modal.style.display='none';
  },true);
  document.getElementById('finalResourceClose').onclick=function(){modal.style.display='none';};
  document.getElementById('finalClearAll').onclick=function(){options.querySelectorAll('input').forEach(function(input){input.checked=false;});selectAll.checked=false;};
  selectAll.onchange=function(){options.querySelectorAll('input').forEach(function(input){input.checked=selectAll.checked;});};
  search.oninput=drawOptions;
  modal.onclick=function(e){if(e.target===modal)modal.style.display='none';};

  const create=document.getElementById('create-quote-page');if(create)window.buildUnifiedQuoteDetails(create,null,false);
  const observer=new MutationObserver(function(){
    [document.getElementById('create-quote-page'),document.getElementById('edit-quote-page')].forEach(function(root){if(root?.classList.contains('active'))window.buildUnifiedQuoteDetails(root,null,false);});
  });
  [document.getElementById('create-quote-page'),document.getElementById('edit-quote-page')].forEach(function(root){if(root)observer.observe(root,{attributes:true,attributeFilter:['class']});});
})();
