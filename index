    const set=function(id,value){const element=document.getElementById(id);if(element)element.textContent=value;};
    set('detailJobNo',job.no);
    set('detailOverviewJob',job.no);
    set('detailJobAddress',job.address);
    set('detailPropertyRow',job.address);
    set('detailPropertyHeading',job.address);
    set('detailClientName',button.dataset.client||button.closest('.job-client-row')?.children[0]?.textContent.trim()||'Client');
    set('detailClientEmail',button.dataset.email||'');
    openPage('job-details-page');
  });

  function prefillCreateQuote(source){
    const root=document.getElementById('create-quote-page');if(!root||!source)return;
    const requestRow=source.closest('.survey-row');
    const jobRequestRow=source.closest('.jd-request-row');
    const jobNo=requestRow?.children[0]?.textContent.trim()||document.getElementById('detailJobNo')?.textContent.trim()||window.__activeJob?.no||'';
    const clientName=requestRow?.children[2]?.textContent.trim()||document.getElementById('detailClientName')?.textContent.trim()||'Consumer Company';
    const address=requestRow?.children[3]?.textContent.trim()||window.__activeJob?.address||'';
    const requestType=jobRequestRow?.children[1]?.textContent.trim()||'';
    const description=requestType||('Survey request for '+jobNo+(address?' — '+address:''));
    const client=root.querySelector('#quoteClientSelect');
    const job=root.querySelector('#quoteJobSelect');
    if(client){
      if(![...client.options].some(function(option){return option.value===clientName;})){const option=document.createElement('option');option.value=clientName;option.textContent=clientName;client.appendChild(option);}
      client.value=clientName;client.dispatchEvent(new Event('change',{bubbles:true}));
    }
    if(job&&jobNo){
      const label=jobNo+' — Survey Request';
      let option=[...job.options].find(function(item){return item.value===jobNo;});
      if(!option){option=document.createElement('option');option.value=jobNo;option.textContent=label;job.appendChild(option);}
      job.disabled=false;job.value=jobNo;job.dispatchEvent(new Event('change',{bubbles:true}));
    }
    const descriptionField=root.querySelector('#quoteStep1 textarea[placeholder^="Describe the requested service"]');
    if(descriptionField)descriptionField.value=description;
    window.buildUnifiedQuoteDetails?.(root,null,false);
  }

  bind('#survey-requests-page .create-from-request,#jobDetailsCreateQuote',function(e){
    if(e.currentTarget.matches('#survey-requests-page .create-from-request')){
      window.__quoteBackOrigin=document.getElementById('view-survey-request-page')?.classList.contains('active')?'view-survey-request-page':'survey-requests-page';
    }
    e.preventDefault();e.stopImmediatePropagation();prefillCreateQuote(e.currentTarget);openPage('create-quote-page');window.buildUnifiedQuoteDetails?.(document.getElementById('create-quote-page'),null,false);
