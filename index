<script id="survey-client-context-gating">
(function(){
  const root=document.getElementById('new-survey-request-page');if(!root)return;
  const clients=[
    {name:'Consumer Company',email:'consumer.cl@mail.com'},
    {name:'QA Tester 3',email:'revew59089@playboot.com'},
    {name:'QA Tester 2',email:'pimebo9836@playboot.com'},
    {name:'No Access Company',email:'yihiser358@joystill.com'}
  ];
  const jobClients={
    'JOB-102':['Consumer Company','QA Tester 2'],
    'JOB-118':['Consumer Company'],
    'JOB-126':['QA Tester 3']
  };
  const addressClients={
    '123 main street':['Consumer Company','QA Tester 2'],
    '550 congress ave':['Consumer Company'],
    '345 apple st':['QA Tester 3']
  };
  const ids=['refSurveyStreet','refSurveyCity','refSurveyState','refSurveyCountry','refSurveyPostal','refSurveyLat','refSurveyLng','refJobSearch'];
  const field=function(id){return document.getElementById(id);};
  const normalize=function(value){return String(value||'').trim().toLowerCase();};
  const initials=function(name){return name.split(/\s+/).map(function(part){return part[0];}).join('').slice(0,2).toUpperCase();};

  function propertyReady(){
    if(root.classList.contains('from-job')||window.__surveyRequestFromJob)return true;
    const mode=root.querySelector('[data-ref-location].active')?.dataset.refLocation||'address';
    const addressComplete=['refSurveyStreet','refSurveyCity','refSurveyState','refSurveyCountry','refSurveyPostal'].every(function(id){return normalize(field(id)?.value);});
    const coordinatesComplete=normalize(field('refSurveyLat')?.value)&&normalize(field('refSurveyLng')?.value);
    const jobComplete=normalize(field('refJobSearch')?.value);
    return !!(jobComplete||(mode==='coordinates'?coordinatesComplete:addressComplete));
  }
  function associatedNames(){
    const job=String(field('refJobSearch')?.value||(root.classList.contains('from-job')?window.__surveyRequestJobNo:'')||'').trim().toUpperCase();
    if(jobClients[job])return jobClients[job];
    const street=normalize(field('refSurveyStreet')?.value);
    const addressKey=Object.keys(addressClients).find(function(key){return street===key||street.startsWith(key);});
    return addressKey?addressClients[addressKey]:[];
  }
  function clientButton(client){
    return '<button type="button" class="sr-client-option crm-client-option" data-client="'+client.name+'" data-name="'+client.name+'" data-email="'+client.email+'"><span class="sr-client-avatar">'+initials(client.name)+'</span><span class="sr-client-copy"><b>'+client.name+'</b><small>'+client.email+'</small></span></button>';
  }
  function renderClients(query){
    const box=field('srClientOptions'),empty=field('srClientEmpty');if(!box)return;
    const q=normalize(query);const associated=new Set(associatedNames());
    const matches=clients.filter(function(client){return !q||normalize(client.name+' '+client.email).includes(q);});
    const recent=matches.filter(function(client){return associated.has(client.name);});
    const others=matches.filter(function(client){return !associated.has(client.name);});
    let html='';
    if(q){html='<div class="sr-client-group-label">Search results</div>'+recent.concat(others).map(clientButton).join('');}
    else{
      if(recent.length)html+='<div class="sr-client-group-label">Recently surveyed for this property</div>'+recent.map(clientButton).join('');
      if(others.length)html+='<div class="sr-client-group-label">'+(recent.length?'All other clients':'All clients')+'</div>'+others.map(clientButton).join('');
    }
    box.innerHTML=html;if(empty)empty.style.display=matches.length?'none':'block';
  }
  function resetSelectedClient(){
    const hidden=field('surveyRequestClient'),text=field('srClientText');
    if(hidden)hidden.value='';
    if(text){text.textContent='Select client...';text.classList.add('placeholder');}
  }
  function syncClientState(){
    const ready=propertyReady();const picker=field('srClientPicker');const trigger=field('srClientTrigger');const add=field('surveyRequestAddClient');const menu=field('srClientMenu');
    if(trigger){trigger.disabled=!ready;trigger.setAttribute('aria-disabled',String(!ready));}
    if(add)add.disabled=!ready;
    picker?.classList.toggle('is-locked',!ready);
    if(!ready){menu?.classList.remove('open');resetSelectedClient();}
    else renderClients(field('srClientSearch')?.value||'');
  }
  function setupPicker(){
    let trigger=field('srClientTrigger'),search=field('srClientSearch'),menu=field('srClientMenu');if(!trigger||!menu)return;
    const freshTrigger=trigger.cloneNode(true);trigger.replaceWith(freshTrigger);trigger=freshTrigger;
    if(search){const freshSearch=search.cloneNode(true);search.replaceWith(freshSearch);search=freshSearch;}
    trigger.addEventListener('click',function(e){
      if(trigger.disabled)return;e.preventDefault();e.stopPropagation();const opening=!menu.classList.contains('open');menu.classList.toggle('open',opening);
      if(opening&&search){search.value='';renderClients('');setTimeout(function(){search.focus();},0);}
    });
    search?.addEventListener('input',function(){renderClients(search.value);});
    menu.addEventListener('click',function(e){
      const option=e.target.closest('.sr-client-option');if(!option)return;const name=option.dataset.client||option.dataset.name;
      const hidden=field('surveyRequestClient'),text=field('srClientText');if(hidden)hidden.value=name;if(text){text.textContent=name;text.classList.remove('placeholder');}menu.classList.remove('open');
    });
    document.addEventListener('click',function(e){if(!e.target.closest('#srClientPicker'))menu.classList.remove('open');});
  }
  ids.forEach(function(id){const input=field(id);input?.addEventListener('input',syncClientState);input?.addEventListener('change',syncClientState);});
  root.querySelectorAll('[data-ref-location]').forEach(function(button){button.addEventListener('click',function(){setTimeout(syncClientState,0);});});
  document.addEventListener('click',function(e){if(e.target.closest('#refJobMenu [data-job]'))setTimeout(syncClientState,0);});
  new MutationObserver(function(){if(root.classList.contains('active'))setTimeout(syncClientState,0);}).observe(root,{attributes:true,attributeFilter:['class']});
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setupPicker();syncClientState();});
  else{setupPicker();syncClientState();}
})();
</script>

