<script>
(function(){
  const opp=document.getElementById('opportunities');
  if(!opp) return;
  const search=opp.querySelector('.crm-search');
  const stageSelect=opp.querySelector('.crm-select');
  const kanban=document.getElementById('opportunityKanban');

  // Turn the visual search field into a real input while preserving its styling.
  if(search && search.tagName!=='INPUT'){
    const input=document.createElement('input');
    input.className='crm-search opportunity-search-input';
    input.placeholder='Search opportunities, prospects, or clients...';
    search.replaceWith(input);
  }
  const input=opp.querySelector('.opportunity-search-input');

  function normalize(s){return (s||'').toLowerCase().trim()}
  function applyFilters(){
    const q=normalize(input ? input.value : '');
    const selected=stageSelect ? stageSelect.value : 'All Stages';

    // Table rows
    opp.querySelectorAll('.crm-table .opp-row:not(.header)').forEach(row=>{
      const rowText=normalize(row.textContent);
      const stageEl=row.querySelector('.stage');
      const stage=stageEl ? stageEl.textContent.trim() : '';
      const searchOK=!q || rowText.includes(q);
      const stageOK=selected==='All Stages' || stage===selected;
      row.style.display=(searchOK && stageOK)?'grid':'none';
    });

    // Kanban columns/cards
    if(kanban){
      kanban.querySelectorAll('.kanban-column').forEach(col=>{
        const title=col.querySelector('.kanban-column-head span:first-child');
        const stageName=title ? title.textContent.trim() : '';
        const stageOK=selected==='All Stages' || stageName===selected;
        let visibleCards=0;
        col.querySelectorAll('.kanban-card').forEach(card=>{
          const ok=!q || normalize(card.textContent).includes(q);
          card.style.display=ok?'block':'none';
          if(ok) visibleCards++;
        });
        // Stage filtering hides entire columns. Search keeps all stage columns visible,
        // so the pipeline structure remains understandable.
        col.style.display=stageOK?'block':'none';
      });
    }
  }

  if(input) input.addEventListener('input',applyFilters);
  if(stageSelect) stageSelect.addEventListener('change',applyFilters);
})();
</script>

