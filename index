<script>
(function(){
  function syncJobNav(page){
    const aliases={
      'jobs':'Jobs',
      'jobs-page':'Jobs',
      'survey-requests':'Survey Requests',
      'survey-requests-page':'Survey Requests',
      'new-survey-request':'Survey Requests',
      'new-survey-request-page':'Survey Requests',
      'quotes':'Quotes',
      'quotes-page':'Quotes',
      'create-quote':'Quotes',
      'create-quote-page':'Quotes'
    };
    const wanted=aliases[page];
    document.querySelectorAll('.subnav a').forEach(a=>a.classList.remove('job-page-selected'));
    if(!wanted)return;
    const link=[...document.querySelectorAll('.subnav a')].find(a=>a.textContent.trim()===wanted);
    if(link){
      link.classList.add('job-page-selected');
      const sub=link.closest('.subnav');
      if(sub){
        sub.classList.add('open');
        const accordion=sub.previousElementSibling;
        if(accordion) accordion.classList.add('open');
      }
    }
  }

  // Capture page navigation from existing links/buttons.
  document.addEventListener('click',function(e){
    const el=e.target.closest('a,button');
    if(!el)return;
    const text=el.textContent.trim();
    if(text==='Jobs') syncJobNav('jobs');
    else if(text==='Survey Requests'||text.includes('New Survey Request')||text.includes('Back to Survey Requests')) syncJobNav('survey-requests');
    else if(text==='Quotes'||text.includes('Create Quote')||text.includes('View Quote')) syncJobNav('quotes');
  });

  // Keep the selected state correct after programmatic page changes too.
  const observer=new MutationObserver(function(){
    const active=document.querySelector('.page-view.active');
    if(active) syncJobNav(active.id);
  });
  document.querySelectorAll('.page-view').forEach(p=>observer.observe(p,{attributes:true,attributeFilter:['class','style']}));

  const initial=document.querySelector('.page-view.active');
  if(initial) syncJobNav(initial.id);
})();
</script>


<script>
(function(){
  const map={
    'jobs-page':'Jobs',
    'survey-requests-page':'Survey Requests',
    'new-survey-request-page':'Survey Requests',
    'quotes-page':'Quotes',
    'create-quote-page':'Quotes'
  };

  function syncSelectedPage(){
    document.querySelectorAll('.subnav a').forEach(a=>{
      a.classList.remove('job-page-selected','subnav-active');
    });

    const active=[...document.querySelectorAll('.page-view')].find(p=>{
      const cs=getComputedStyle(p);
      return p.classList.contains('active') && cs.display!=='none';
    });
    if(!active)return;

    const wanted=map[active.id];
    if(!wanted)return;

    const link=[...document.querySelectorAll('.subnav a')]
      .find(a=>a.textContent.trim()===wanted);

    if(link){
      link.classList.add('job-page-selected');
      const sub=link.closest('.subnav');
      if(sub){
        sub.classList.add('open');
        sub.previousElementSibling?.classList.add('open');
      }
    }
  }

  // Run after every page change.
  const observer=new MutationObserver(()=>requestAnimationFrame(syncSelectedPage));
  document.querySelectorAll('.page-view').forEach(p=>{
    observer.observe(p,{attributes:true,attributeFilter:['class','style']});
  });

  window.addEventListener('load',syncSelectedPage);
  document.addEventListener('click',()=>setTimeout(syncSelectedPage,0));
})();
</script>


<script>
(function(){
 const records=[
  {no:'JOB-102',street:'123 Main Street',city:'Austin',state:'Texas',country:'United States',postal:'78701',lat:'30.2672',lng:'-97.7431'},
  {no:'JOB-118',street:'550 Congress Ave',city:'Austin',state:'Texas',country:'United States',postal:'78701',lat:'30.2676',lng:'-97.7429'},
  {no:'JOB-126',street:'345 Apple St',city:'Toronto',state:'Ontario',country:'Canada',postal:'M5V 2T6',lat:'43.6426',lng:'-79.3871'}
 ];

 function lockFromJob(){
   if(!window.__surveyRequestFromJob)return;
   const page=document.getElementById('new-survey-request-page');if(!page)return;
   const r=records.find(x=>x.no===window.__surveyRequestJobNo) || records[0];

   page.classList.add('from-job');

   const vals={
    refSurveyStreet:r.street,refSurveyCity:r.city,refSurveyState:r.state,
    refSurveyCountry:r.country,refSurveyPostal:r.postal,
    refSurveyLat:r.lat,refSurveyLng:r.lng,refJobSearch:r.no
   };
   Object.entries(vals).forEach(([id,val])=>{
     const el=document.getElementById(id);
     if(el){el.value=val;el.disabled=true;}
   });

   // Ensure Address is the visible locked property representation.
   page.querySelectorAll('[data-ref-location]').forEach(b=>{
     b.classList.toggle('active',b.dataset.refLocation==='address');
     b.disabled=true;
   });
   document.getElementById('refAddressPanel')?.classList.add('active');
   document.getElementById('refCoordinatesPanel')?.classList.remove('active');

   const help=document.getElementById('refJobHelp');
   if(help && !document.querySelector('.from-job-note')){
     const note=document.createElement('div');
     note.className='from-job-note';
     note.textContent='Subject Property and Job Number are set from the selected job and cannot be changed for this request.';
     help.insertAdjacentElement('afterend',note);
   }
 }

 document.addEventListener('click',e=>{
   if(e.target.closest('.jobs-create-request')) setTimeout(lockFromJob,0);
 });
})();
</script>


