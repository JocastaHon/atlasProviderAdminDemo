<script id="all-form-required-actions">
(function(){
  const configurations=[
    {scope:'#new-survey-request-page',buttons:'.create-quote-actions .header-create'},
    {scope:'#create-quote-page',buttons:'#quoteNextStep'},
    {scope:'#edit-quote-page',buttons:'.create-quote-actions .header-create,#edit-quoteNextStep'},
    {scope:'#add-client-page',buttons:'#createClientFromPage'},
    {scope:'#edit-client-page',buttons:'.edit-client-actions .header-create'},
    {scope:'#crmContactEditModal',buttons:'#saveCrmContactEdit'},
    {scope:'#editContactModal',buttons:'#saveEditContact'},
    {scope:'#addContactModal',buttons:'.contact-edit-footer .header-create'},
    {scope:'#newOpportunityModal',buttons:'.opp-modal-footer .header-create'},
    {scope:'#quoteQuickClientModal',buttons:'#quoteQuickClientAdd'},
    {scope:'#addClientModal',buttons:'#saveClientModal'}
  ];
  const fieldBlockSelector='.form-field,.quote-field,.quick-client-field,.opp-field,.new-job-field';

  function isScopeAvailable(scope){
    if(scope.classList.contains('page-view'))return scope.classList.contains('active');
    return getComputedStyle(scope).display!=='none';
  }
  function isVisibleBlock(block){return block.getClientRects().length>0&&getComputedStyle(block).visibility!=='hidden';}
  function requiredControls(scope){
    const controls=new Set(scope.querySelectorAll('input[required],select[required],textarea[required]'));
    scope.querySelectorAll(fieldBlockSelector).forEach(function(block){
      if(!isVisibleBlock(block))return;
      const label=block.querySelector('label');
      if(!label||(!label.querySelector('.req')&&!label.textContent.includes('*')))return;
      const control=block.querySelector('input:not([type="checkbox"]),select,textarea');
      if(control)controls.add(control);
    });
    return [...controls].filter(function(control){
      const block=control.closest(fieldBlockSelector);
      return !block||isVisibleBlock(block);
    });
  }
  function hasValue(control){
    if(control.type==='checkbox'||control.type==='radio')return control.checked;
    const value=String(control.value||'').trim();
    if(!value)return false;
    if(control.tagName==='SELECT'&&control.selectedIndex===0){
      const text=(control.options[0]?.textContent||'').toLowerCase();
      if(/select|choose|search/.test(text))return false;
    }
    return true;
  }
  function refresh(configuration){
    const scope=document.querySelector(configuration.scope);if(!scope||!isScopeAvailable(scope))return;
    const required=requiredControls(scope),complete=required.length===0||required.every(hasValue);
    scope.querySelectorAll(configuration.buttons).forEach(function(button){
      button.disabled=!complete;
      button.setAttribute('aria-disabled',String(!complete));
    });
  }
  function refreshAll(){configurations.forEach(refresh);}
  document.addEventListener('input',refreshAll,true);
  document.addEventListener('change',refreshAll,true);
  document.addEventListener('click',function(){setTimeout(refreshAll,0);},true);
  document.addEventListener('focusin',refreshAll,true);
  new MutationObserver(function(mutations){
    if(mutations.some(function(item){return item.type==='childList'||item.attributeName==='class'||item.attributeName==='style';}))setTimeout(refreshAll,0);
  }).observe(document.body,{subtree:true,childList:true,attributes:true,attributeFilter:['class','style']});
  refreshAll();
})();
</script>

<script id="create-quote-required-actions">
(function(){
  const page=document.getElementById('create-quote-page');if(!page)return;
  const createButton=page.querySelector('.create-quote-actions .header-create');
  const addServiceButton=page.querySelector('.services-block .quote-primary');
  const serviceSelect=page.querySelector('.services-block .service-select');

  function controlValid(control){
    if(!control)return false;
    const value=String(control.value||'').trim();if(!value)return false;
    if(control.tagName==='SELECT'&&control.selectedIndex===0&&/select|choose|search/i.test(control.options[0]?.textContent||''))return false;
    return true;
  }
  function stepOneComplete(){
    const unified=page.querySelector('.unified-quote-details');
    if(unified){
      return ['client','job','description'].every(function(name){return controlValid(unified.querySelector('[data-unified-field="'+name+'"]'));});
    }
    const step=page.querySelector('#quoteStep1');
    const required=[...step.querySelectorAll('.quote-field')].filter(function(field){const locationPanel=field.closest('.location-panel');return field.querySelector('label .req')&&(!locationPanel||locationPanel.classList.contains('active'));}).map(function(field){return field.querySelector('input,select,textarea');});
    return required.length>0&&required.every(controlValid);
  }
  function hasService(){
    const list=page.querySelector('#addedServicesList');
    const thermal=page.querySelector('#thermalInspectionTable');
    return Boolean(list?.children.length)||(thermal&&getComputedStyle(thermal).display!=='none');
  }
  function refresh(){
    const serviceChosen=Boolean(serviceSelect&&serviceSelect.selectedIndex>0);
    if(addServiceButton){addServiceButton.disabled=!serviceChosen;addServiceButton.setAttribute('aria-disabled',String(!serviceChosen));}
    const complete=stepOneComplete()&&hasService();
    if(createButton){createButton.disabled=!complete;createButton.setAttribute('aria-disabled',String(!complete));}
  }
  page.addEventListener('input',refresh,true);page.addEventListener('change',refresh,true);page.addEventListener('click',function(){setTimeout(refresh,0);},true);
  new MutationObserver(refresh).observe(page,{subtree:true,childList:true,attributes:true,attributeFilter:['class','style']});
  document.addEventListener('click',function(){setTimeout(refresh,0);},true);
  refresh();
})();
</script>

