    if(row)window.selectQuoteForEditing?.(row);
    window.prepareSelectedQuoteForEdit?.();
    openPage('edit-quote-page');
  });

  /* Delegated actions also cover rows created during this browser session. */
  document.addEventListener('click',function(e){
    if(e.target.closest('#quotes-page .quote-actions .view-action')){
      e.preventDefault();e.stopImmediatePropagation();
      window.selectQuoteForEditing?.(e.target.closest('.quotes-row'));
      openPage('view-quote-page');return;
    }
    if(e.target.closest('#quotes-page .quote-actions .edit-action')){
      e.preventDefault();e.stopImmediatePropagation();
      window.selectQuoteForEditing?.(e.target.closest('.quotes-row'));
      window.prepareSelectedQuoteForEdit?.();
      openPage('edit-quote-page');return;
    }
    if(e.target.closest('#survey-requests-page .create-from-request')){
      window.__quoteBackOrigin=document.getElementById('view-survey-request-page')?.classList.contains('active')?'view-survey-request-page':'survey-requests-page';
      e.preventDefault();e.stopImmediatePropagation();const source=e.target.closest('#survey-requests-page .create-from-request');prefillCreateQuote(source);openPage('create-quote-page');window.buildUnifiedQuoteDetails?.(document.getElementById('create-quote-page'),null,false);return;
    }
    if(e.target.closest('#survey-requests-page .view-created-quote')){
      e.preventDefault();e.stopImmediatePropagation();openPage('view-quote-page');
    }
  },true);

  bind('#new-survey-request-page .create-quote-actions .header-create',function(e){
    e.preventDefault();
    e.stopImmediatePropagation();
    const table=document.querySelector('#survey-requests-page .survey-table');
    const source=table?.querySelector('.survey-row:not(.head)');
    if(table && source){
      const row=source.cloneNode(true);
      const max=[...table.querySelectorAll('.survey-row:not(.head) b')]
        .map(function(item){return Number((item.textContent.match(/\d+/)||[0])[0]);})
        .reduce(function(a,b){return Math.max(a,b);},132);
      const job=window.__surveyRequestJobNo||'JOB-'+(max+1);
      const client=document.getElementById('surveyRequestClient')?.value||'New Client';
      row.children[0].textContent='';
      const jobLink=document.createElement('a');
      jobLink.href='#';
      jobLink.className='survey-job-link';
      jobLink.dataset.job=job;
      jobLink.textContent=job;
      row.children[0].appendChild(jobLink);
      row.children[1].textContent=new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
      row.children[2].textContent=client;
      row.children[4].innerHTML='<span class="survey-status pending">Pending</span>';
      table.insertBefore(row,source);
    }
    openPage('survey-requests-page');
  });

  bind('#create-quote-page .create-quote-actions .header-create',function(e){
    e.preventDefault();
    e.stopImmediatePropagation();
    const table=document.querySelector('#quotes-page .crm-table');
    const source=table?.querySelector('.crm-row.quotes-row:not(.header)');
    if(table && source){
      const row=source.cloneNode(true);
      const ids=[...table.querySelectorAll('.quote-id')].map(function(item){return Number((item.textContent.match(/\d+/)||[0])[0]);});
      const newQuoteId='Q-'+(Math.max(131,...ids)+1);
      row.querySelector('.quote-id').textContent=newQuoteId;
      row.dataset.quoteId=newQuoteId;
      row.children[1].textContent=document.getElementById('quoteClientSelect')?.value||'New Client';
      row.children[2].textContent=document.querySelector('#create-quote-page textarea[placeholder^="Describe the requested service"]')?.value.trim()||'New survey quote';
      row.children[3].innerHTML='<span class="quote-status-pill">Draft</span>';
      row.children[4].textContent=document.getElementById('grandTotal')?.textContent||'$0.00';
      row.children[5].textContent=new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
      row.classList.add('quote-row-editable');
      const editAction=row.querySelector('.edit-action');
      if(editAction)editAction.style.setProperty('display','flex','important');
      table.insertBefore(row,source);
      window.storeCreatedQuoteState?.(newQuoteId,row);
    }
    openPage('quotes-page');
  });

  bind('#edit-quote-page .create-quote-actions .header-create',function(e){
    e.preventDefault();e.stopImmediatePropagation();
    window.saveActiveQuoteEdit?.();
    openPage('view-quote-page');
  });

  const observer=new MutationObserver(function(mutations){
    if(mutations.some(function(mutation){return mutation.type==='attributes';})){
      setTimeout(repairActivePage,0);
    }
  });
  document.querySelectorAll('.page-view').forEach(function(page){
    observer.observe(page,{attributes:true,attributeFilter:['class']});
  });

  window.openJobManagementPage=openPage;
  repairActivePage();
})();
</script>

