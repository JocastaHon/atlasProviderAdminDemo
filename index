<script id="quote-edit-autopopulate">
(function(){
  const states=window.__quoteEditStates=window.__quoteEditStates||{};
  let activeQuoteId='';
  let activeQuoteRow=null;

  const clientDefaults={
    'Consumer Company':{job:'Job #102 — North Site Survey',jobShort:'JOB-102',survey:'Property Survey',street:'123 Main Street',city:'Austin',state:'Texas',country:'United States',postal:'78701',lat:'30.2672',lng:'-97.7431',currency:'USD — US Dollar'},
    'QA Tester 3':{job:'Job #126 — Toronto Inspection',jobShort:'JOB-126',survey:'Inspection',street:'345 Apple St',city:'Toronto',state:'Ontario',country:'Canada',postal:'M5V 2T6',lat:'43.6426',lng:'-79.3871',currency:'CAD — Canadian Dollar'},
    'No Access Company':{job:'Job #091 — Property Survey',jobShort:'JOB-091',survey:'Mapping',street:'1123 Apple',city:'Toronto',state:'Ontario',country:'Canada',postal:'M5V 2T6',lat:'43.6532',lng:'-79.3832',currency:'CAD — Canadian Dollar'}
  };

  function money(value){
    const number=Number(String(value||'0').replace(/[^0-9.-]/g,''))||0;
    return '$'+number.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
  }

  function ensureOption(select,value,label){
    if(!select || !value)return;
    let option=[...select.options].find(function(item){return item.value===value || item.textContent.trim()===label;});
    if(!option){option=document.createElement('option');option.value=value;option.textContent=label;select.appendChild(option);}
    select.value=option.value;
  }

  function quoteField(root,sectionTitle,label){
    const sections=[...root.querySelectorAll('.quote-section')];
    const section=sections.find(function(item){
      return item.querySelector('.quote-section-title')?.textContent.replace('*','').trim()===sectionTitle;
    });
    const fields=[...(section||root).querySelectorAll('.quote-field')];
    const holder=fields.find(function(item){
      return item.querySelector('label')?.textContent.replace('*','').trim()===label;
    });
    return holder?.querySelector('input,select,textarea')||null;
  }

  function setValue(element,value){
    if(!element)return;
    if(element.tagName==='SELECT')ensureOption(element,String(value),String(value));
    else element.value=value??'';
    element.dispatchEvent(new Event('change',{bubbles:true}));
    element.dispatchEvent(new Event('input',{bubbles:true}));
  }

  function controls(root){return [...root.querySelectorAll('input,select,textarea')];}

  function captureRoot(root,meta){
    const valueState=controls(root).map(function(element){
      return {value:element.value,checked:element.checked,type:element.type,options:element.tagName==='SELECT'?[...element.options].map(function(option){return {value:option.value,text:option.textContent};}):null};
    });
    const selected=function(id){return root.querySelector('#'+id)?.textContent.trim()||'None selected';};
    const count=function(id){return root.querySelector('#'+id)?.textContent.trim()||'(0)';};
    const total=function(id){return root.querySelector('#'+id)?.textContent.trim()||'$0.00';};
    const prefix=root.id==='edit-quote-page'?'edit-':'';
    const resourcePrices={delivery:{},equipment:{},drones:{}};
    ['delivery','equipment','drones'].forEach(function(type){
      const selected=root.querySelector('#'+prefix+type+'Selected');
      const card=selected?.closest('.quote-resource-card');
      card?.querySelectorAll('.final-selected-row').forEach(function(row){
        const name=row.dataset.name||row.querySelector('span')?.textContent.trim();
        if(name)resourcePrices[type][name]=Number(row.querySelector('input')?.value||0);
      });
    });
    return {
      meta:meta,
      controlValues:valueState,
      location:[...root.querySelectorAll('.location-mode button')].find(function(button){return button.classList.contains('active');})?.dataset.location||'address',
      addedServicesHTML:root.querySelector('#'+prefix+'addedServicesList')?.innerHTML||'',
      thermalDisplay:root.querySelector('#'+prefix+'thermalInspectionTable')?.style.display||'none',
      providerNoticeDisplay:root.querySelector('#'+prefix+'providerNotice')?.style.display||'none',
      providerSectionDisplay:root.querySelector('#'+prefix+'providerSendAddressesSection')?.style.display||'none',
      providerRowsHTML:root.querySelector('#'+prefix+'providerSelectedAddressRows')?.innerHTML||'',
      resources:{delivery:selected(prefix+'deliverySelected'),equipment:selected(prefix+'equipmentSelected'),drones:selected(prefix+'dronesSelected')},
      counts:{delivery:count(prefix+'deliveryCount'),equipment:count(prefix+'equipmentCount'),drones:count(prefix+'dronesCount')},
      resourcePrices:resourcePrices,
      totals:{provider:total(prefix+'providerTotal'),delivery:total(prefix+'deliveryTotal'),equipment:total(prefix+'equipmentTotal'),drones:total(prefix+'dronesTotal'),grand:total(prefix+'grandTotal')}
    };
  }

  function rowMeta(row){
    if(!row)return {id:'Q-129',client:'Consumer Company',description:'Thermal imaging inspection',status:'Submitted',total:'$8,000',date:'Aug 18, 2026'};
    const cells=row.children;
    const id=row.querySelector('.quote-id')?.textContent.trim()||row.dataset.quoteId||'Q-129';
    row.dataset.quoteId=id;
    return {id:id,client:cells[1]?.textContent.trim()||'Consumer Company',description:cells[2]?.textContent.trim()||'Survey quote',status:cells[3]?.textContent.trim()||'Draft',total:cells[4]?.textContent.trim()||'$0.00',date:cells[5]?.textContent.trim()||''};
  }

  function defaultState(meta){
    const defaults=clientDefaults[meta.client]||clientDefaults['Consumer Company'];
    const service=/thermal/i.test(meta.description)?'Thermal Inspection':/roof/i.test(meta.description)?'Roof Inspection':/mapping/i.test(meta.description)?'Orthomosaic Mapping':/inspection/i.test(meta.description)?'Aerial Surveying':'Property Survey';
    return {
      meta:meta,
      defaults:Object.assign({},defaults,{
        description:meta.description,
        requested:'2026-08-18',expected:'2026-09-01',section:'12',township:defaults.city,
        range:'3',lot:'24',block:'B',certify:meta.client,
        legal:'Survey and legal description associated with '+defaults.jobShort+'.',
        notes:'Quote prepared for '+meta.description+'.',quoteNotes:'Pricing and scope retained from '+meta.id+'.',service:service
      }),
      location:'address',
      resources:{delivery:'Client Portal',equipment:'RTK GPS',drones:'DJI Matrice 350 RTK'},
      counts:{delivery:'(1)',equipment:'(1)',drones:'(1)'},
      totals:{provider:money(meta.total),delivery:'$0.00',equipment:'$0.00',drones:'$0.00',grand:money(meta.total)}
    };
  }

  function applyControlSnapshot(root,state){
    if(!state.controlValues)return false;
    const targetControls=controls(root);
    state.controlValues.forEach(function(saved,index){
      const target=targetControls[index];if(!target)return;
      if(target.tagName==='SELECT' && saved.options){
        saved.options.forEach(function(option){ensureOption(target,option.value,option.text);});
      }
      if(target.type==='checkbox' || target.type==='radio')target.checked=!!saved.checked;
      else setValue(target,saved.value);
    });
    return true;
  }

  function applyDefaults(root,state){
    const d=state.defaults;
    const client=root.querySelector('#edit-quoteClientSelect');
    const job=root.querySelector('#edit-quoteJobSelect');
    ensureOption(client,d.client||state.meta.client,d.client||state.meta.client);
    client.value=state.meta.client;
    job.disabled=false;job.innerHTML='';ensureOption(job,d.job,d.job);
    setValue(quoteField(root,'Quote Details','Survey Type'),d.survey);
    setValue(quoteField(root,'Quote Details','Requested Date'),d.requested);
    setValue(quoteField(root,'Quote Details','Expected Close'),d.expected);
    setValue(quoteField(root,'Quote Details','Description'),d.description);
    setValue(quoteField(root,'Subject Property','Street Address'),d.street);
    setValue(quoteField(root,'Subject Property','City'),d.city);
    setValue(quoteField(root,'Subject Property','State / Province'),d.state);
    setValue(quoteField(root,'Subject Property','Country'),d.country);
    setValue(quoteField(root,'Subject Property','ZIP / Postal Code'),d.postal);
    setValue(quoteField(root,'Subject Property','Latitude'),d.lat);
    setValue(quoteField(root,'Subject Property','Longitude'),d.lng);
    setValue(quoteField(root,'Property & Legal Information','Section'),d.section);
    setValue(quoteField(root,'Property & Legal Information','Township'),d.township);
    setValue(quoteField(root,'Property & Legal Information','Range'),d.range);
    setValue(quoteField(root,'Property & Legal Information','Lot'),d.lot);
    setValue(quoteField(root,'Property & Legal Information','Block'),d.block);
    setValue(quoteField(root,'Property & Legal Information','Certify To'),d.certify);
    setValue(quoteField(root,'Property & Legal Information','Legal Description'),d.legal);
    setValue(quoteField(root,'Attachments & Notes','Notes'),d.notes);
    setValue(root.querySelector('#edit-quoteStep2 .currency-box select'),d.currency);
    setValue(root.querySelector('#edit-quoteStep2 .service-select'),d.service);
    setValue(root.querySelector('#edit-quoteStep2 textarea[placeholder="Additional quote notes..."]'),d.quoteNotes);
    const list=root.querySelector('#edit-addedServicesList');
    if(list)list.innerHTML='<div class="standard-service-example" style="display:block"><div class="std-head"><span>Service</span><span>Client Price</span><span>Model</span><span>Hours</span><span>Disc %</span><span>Subtotal</span><span>Est. Total</span></div><div class="std-row"><b>'+d.service+'</b><input type="number" value="'+String(state.meta.total).replace(/[^0-9.]/g,'')+'"><span><span class="std-model">Fixed</span></span><span>1</span><input type="number" value="0"><span>'+money(state.meta.total)+'</span><span><b>'+money(state.meta.total)+'</b></span></div></div>';
  }

  function renderEditContext(root,state){
    if(window.buildUnifiedQuoteDetails){window.buildUnifiedQuoteDetails(root,state);return;}
    let summary=root.querySelector('.edit-quote-context-summary');
    if(!summary){
      summary=document.createElement('section');
      summary.className='edit-quote-context-summary';
      summary.innerHTML='<h2 class="edit-quote-context-title">Quote Context</h2><div class="edit-quote-context-grid"><div class="edit-quote-context-item"><span>Client</span><b data-edit-context="client"></b></div><div class="edit-quote-context-item"><span>Job Number</span><b data-edit-context="job"></b></div><div class="edit-quote-context-item full"><span>Description</span><p data-edit-context="description"></p></div></div>';
      const head=root.querySelector('.create-quote-head');
      head?.insertAdjacentElement('afterend',summary);
    }
    const value=function(name,text){const element=summary.querySelector('[data-edit-context="'+name+'"]');if(element)element.textContent=text||'—';};
    value('client',root.querySelector('#edit-quoteClientSelect')?.value||state.meta.client);
    value('job',root.querySelector('#edit-quoteJobSelect')?.selectedOptions[0]?.textContent||'—');
    value('description',quoteField(root,'Quote Details','Description')?.value||state.meta.description);
  }

  function applyState(state){
    const root=document.getElementById('edit-quote-page');if(!root || !state)return;
    window.buildUnifiedQuoteDetails?.(root,state,true);
    root.querySelectorAll('input,textarea').forEach(function(element){if(element.type!=='number')element.value='';});
    const services=root.querySelector('#edit-addedServicesList');if(services)services.innerHTML=state.addedServicesHTML||'';
    const providerRows=root.querySelector('#edit-providerSelectedAddressRows');if(providerRows)providerRows.innerHTML=state.providerRowsHTML||'';
    const usedSnapshot=applyControlSnapshot(root,state);
    if(!usedSnapshot)applyDefaults(root,state);

    const defaults=clientDefaults[state.meta.client]||clientDefaults['Consumer Company'];
    const client=root.querySelector('#edit-quoteClientSelect');
    const job=root.querySelector('#edit-quoteJobSelect');
    ensureOption(client,state.meta.client,state.meta.client);client.value=state.meta.client;
    job.disabled=false;
    if(!job.value){job.innerHTML='';ensureOption(job,defaults.job,defaults.job);}
    const help=document.getElementById('edit-quoteJobHelp');if(help)help.textContent='Editing '+job.options[job.selectedIndex]?.textContent+' for '+state.meta.client+'.';

    root.querySelectorAll('.location-mode button').forEach(function(button){button.classList.toggle('active',button.dataset.location===(state.location||'address'));});
    root.querySelector('#edit-addressLocation')?.classList.toggle('active',(state.location||'address')==='address');
    root.querySelector('#edit-coordinatesLocation')?.classList.toggle('active',state.location==='coordinates');

    const thermal=root.querySelector('#edit-thermalInspectionTable');if(thermal)thermal.style.display=state.thermalDisplay||thermal.style.display;
    const provider=root.querySelector('#edit-providerNotice');if(provider)provider.style.display=state.providerNoticeDisplay||'none';
    const providerSection=root.querySelector('#edit-providerSendAddressesSection');if(providerSection)providerSection.style.display=state.providerSectionDisplay||'none';

    ['delivery','equipment','drones'].forEach(function(type){
      const selected=root.querySelector('#edit-'+type+'Selected');if(selected)selected.textContent=state.resources?.[type]||'None selected';
      const count=root.querySelector('#edit-'+type+'Count');if(count)count.textContent=state.counts?.[type]||'(0)';
      const total=root.querySelector('#edit-'+type+'Total');if(total)total.textContent=state.totals?.[type]||'$0.00';
    });
    const providerTotal=root.querySelector('#edit-providerTotal');if(providerTotal)providerTotal.textContent=state.totals?.provider||'$0.00';
    const grand=root.querySelector('#edit-grandTotal');if(grand)grand.textContent=state.totals?.grand||money(state.meta.total);

    const stepper=root.querySelector('.quote-stepper');if(stepper)stepper.style.setProperty('display','none','important');
    const intro=root.querySelector('.quote-workflow-intro');if(intro)intro.style.setProperty('display','none','important');
    const step1=root.querySelector('#edit-quoteStep1');if(step1){step1.classList.remove('active');step1.style.setProperty('display','none','important');}
    const step2=root.querySelector('#edit-quoteStep2');if(step2){step2.classList.add('active');step2.style.setProperty('display','block','important');}
    const previous=root.querySelector('#edit-quotePrevStep');if(previous)previous.style.setProperty('display','none','important');
    renderEditContext(root,state);
  }

  function updateDetails(state){
    const view=document.getElementById('view-quote-page');if(!view || !state)return;
    const d=state.defaults||clientDefaults[state.meta.client]||clientDefaults['Consumer Company'];
    const summary=view.querySelectorAll('.vq-summary b,.vq-summary em');
    if(summary[0])summary[0].textContent=state.meta.id;
    if(summary[1])summary[1].textContent=d.jobShort||String(d.job||'').match(/JOB-?\d+/i)?.[0]||'JOB-102';
    if(summary[2])summary[2].textContent=state.meta.client;
    if(summary[3])summary[3].textContent=state.meta.status;
    const property=view.querySelectorAll('.vq-property-grid b');
    if(property[0])property[0].textContent=[d.street,d.city,d.state,d.postal].filter(Boolean).join(', ');
    if(property[1])property[1].textContent=d.country||'';
    if(property[2])property[2].textContent=d.jobShort||'JOB-102';
    const total=view.querySelector('.vq-totals .total b');if(total)total.textContent=(d.currency||'USD').slice(0,3)+' '+(state.totals?.grand||money(state.meta.total));
    const notes=view.querySelector('.vq-notes');if(notes)notes.textContent=d.quoteNotes||d.notes||state.meta.description;
  }

  window.selectQuoteForEditing=function(row){
    activeQuoteRow=row||activeQuoteRow;
    const meta=rowMeta(activeQuoteRow);
    activeQuoteId=meta.id;
    if(!states[activeQuoteId])states[activeQuoteId]=defaultState(meta);
    updateDetails(states[activeQuoteId]);
  };

  window.prepareSelectedQuoteForEdit=function(){
    if(!activeQuoteId)window.selectQuoteForEditing(document.querySelector('#quotes-page .quotes-row:not(.header)'));
    applyState(states[activeQuoteId]);
  };

  window.storeCreatedQuoteState=function(id,row){
    const meta=rowMeta(row);meta.id=id;
    const captured=captureRoot(document.getElementById('create-quote-page'),meta);
    captured.defaults=Object.assign({},clientDefaults[meta.client]||clientDefaults['Consumer Company'],{description:meta.description,quoteNotes:quoteField(document.getElementById('create-quote-page'),'Quote Notes','')?.value||''});
    states[id]=captured;
  };

  window.saveActiveQuoteEdit=function(){
    if(!activeQuoteId)return;
    const root=document.getElementById('edit-quote-page');
    const old=states[activeQuoteId]||defaultState(rowMeta(activeQuoteRow));
    const client=root.querySelector('#edit-quoteClientSelect')?.value||old.meta.client;
    const description=quoteField(root,'Quote Details','Description')?.value||old.meta.description;
    const total=root.querySelector('#edit-grandTotal')?.textContent||old.meta.total;
    const meta=Object.assign({},old.meta,{client:client,description:description,total:total});
    const saved=captureRoot(root,meta);
    saved.defaults=Object.assign({},old.defaults||clientDefaults[client]||clientDefaults['Consumer Company'],{client:client,description:description,quoteNotes:root.querySelector('#edit-quoteStep2 textarea[placeholder="Additional quote notes..."]')?.value||''});
    states[activeQuoteId]=saved;
    if(activeQuoteRow){activeQuoteRow.children[1].textContent=client;activeQuoteRow.children[2].textContent=description;activeQuoteRow.children[4].textContent=total;}
    updateDetails(saved);
  };

  document.getElementById('edit-quoteClientSelect')?.addEventListener('change',function(){
    const defaults=clientDefaults[this.value];const job=document.getElementById('edit-quoteJobSelect');if(!defaults||!job)return;
    job.disabled=false;job.innerHTML='';ensureOption(job,defaults.job,defaults.job);
  });
  document.getElementById('edit-quoteNextStep')?.addEventListener('click',function(e){
    e.preventDefault();document.getElementById('edit-quoteStep1')?.classList.remove('active');document.getElementById('edit-quoteStep2')?.classList.add('active');document.querySelectorAll('#edit-quote-page [data-step-indicator]').forEach(function(step){step.classList.toggle('active',step.dataset.stepIndicator==='2');});window.scrollTo(0,0);
  },true);
  document.getElementById('edit-quotePrevStep')?.addEventListener('click',function(e){
    e.preventDefault();document.getElementById('edit-quoteStep2')?.classList.remove('active');document.getElementById('edit-quoteStep1')?.classList.add('active');document.querySelectorAll('#edit-quote-page [data-step-indicator]').forEach(function(step){step.classList.toggle('active',step.dataset.stepIndicator==='1');});window.scrollTo(0,0);
  },true);

  document.querySelectorAll('#quotes-page .quotes-row:not(.header)').forEach(function(row){row.dataset.quoteId=row.querySelector('.quote-id')?.textContent.trim()||'';});
})();
</script>

