<script id="quote-details-edit-working-fix">
(function(){
  function showOnlyPage(page){
    document.querySelectorAll('.page-view').forEach(function(p){
      p.classList.remove('active');
      p.style.setProperty('display','none','important');
    });
    page.classList.add('active');
    page.style.setProperty('display','block','important');
    window.scrollTo(0,0);
  }

  function copyCreateStylesToEdit(){
    // The cloned page has the same classes as Create Quote, so only ID-scoped
    // rules need mirroring. Duplicate them dynamically once.
    const style=document.createElement('style');
    let rules='';
    [...document.styleSheets].forEach(function(sheet){
      try{
        [...sheet.cssRules].forEach(function(rule){
          if(rule.cssText && rule.cssText.includes('#create-quote-page')){
            rules += rule.cssText.replaceAll('#create-quote-page','#edit-quote-page')+'\n';
          }
        });
      }catch(e){}
    });
    style.textContent=rules;
    document.head.appendChild(style);
  }

  function populateEditQuote(){
    const edit=document.getElementById('edit-quote-page');
    if(!edit)return;

    // Prepopulate common visible values from Quote Details.
    const details=document.getElementById('view-quote-page');
    const text=(details?.innerText||'');
    const job=(text.match(/JOB-\d+/i)||[])[0]||'JOB-102';

    edit.querySelectorAll('input,select,textarea').forEach(function(el){
      const label=((el.closest('.quote-field,.form-group,.field')?.querySelector('label')?.textContent||'')+
                   ' '+(el.name||'')+' '+(el.placeholder||'')).toLowerCase();
      if(label.includes('job') && el.tagName==='SELECT'){
        const opt=[...el.options].find(o=>(o.textContent||'').includes(job));
        if(opt)el.value=opt.value;
      }
    });
  }

  document.addEventListener('click',function(e){
    const button=e.target.closest('#view-quote-page button');
    if(!button)return;
    const label=(button.textContent||'').replace(/\s+/g,' ').trim().toLowerCase();
    if(label!=='edit quote')return;

    e.preventDefault();
    e.stopImmediatePropagation();

    const edit=document.getElementById('edit-quote-page');
    if(!edit)return;
    populateEditQuote();
    window.prepareSelectedQuoteForEdit?.();
    showOnlyPage(edit);
  },true);

  window.addEventListener('DOMContentLoaded',copyCreateStylesToEdit);
})();
</script>








