<script>
function showPage(name){
  const target=document.getElementById(name+'-page');
  if(!target) return;

  document.querySelectorAll('.page-view').forEach(function(p){
    p.classList.remove('active');
    p.style.removeProperty('display');
  });
  target.classList.add('active');

  /* Clear ALL navigation selection first. */
  document.querySelectorAll('.side .nav,.side .page-link,.side .subnav a').forEach(function(item){
    item.classList.remove('active','selected','subnav-active','job-page-selected');
    item.removeAttribute('aria-current');
  });

  /* Select only the exact page currently being viewed. */
  if(name==='dashboard' || name==='crm'){
    const link=document.querySelector('.page-link[data-page="'+name+'"]');
    if(link){
      link.classList.add('active');
      link.setAttribute('aria-current','page');
    }
  }

  if(name==='jobs'){
    const link=document.querySelector('.job-jobs-link');
    if(link){
      link.classList.add('subnav-active');
      link.setAttribute('aria-current','page');
    }
  }

  if(name==='survey-requests'){
    const link=document.querySelector('.job-survey-requests-link');
    if(link){
      link.classList.add('subnav-active');
      link.setAttribute('aria-current','page');
    }
  }

  if(name==='quotes'){
    const link=document.querySelector('.job-quotes-link');
    if(link){
      link.classList.add('subnav-active');
      link.setAttribute('aria-current','page');
    }
