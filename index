<script>
(function(){
  function normalizeStatus(value){
    return (value || '').replace(/\s+/g,' ').trim().toLowerCase();
  }

  function syncQuoteEditButton(){
    const page=document.getElementById('view-quote-page');
    if(!page)return;

    const statusEl=page.querySelector('.vq-summary em, .qstatus, [data-quote-status]');
    const status=normalizeStatus(statusEl?.textContent);
    const canEdit=status==='draft' || status==='submitted';

    const editBtn=[...page.querySelectorAll('button')].find(
      b=>normalizeStatus(b.textContent)==='edit quote'
    );
    if(editBtn) editBtn.style.display=canEdit?'inline-flex':'none';
  }

  // Run on load and whenever View Quote becomes active/changes status.
  window.addEventListener('DOMContentLoaded',syncQuoteEditButton);
  const page=document.getElementById('view-quote-page');
  if(page){
    new MutationObserver(syncQuoteEditButton).observe(page,{
      subtree:true,childList:true,characterData:true,attributes:true
    });
  }

  // Expose helper so quote rows can open details with the correct status.
  window.setQuoteDetailsStatus=function(status){
    const statusEl=document.querySelector('#view-quote-page .vq-summary em');
    if(statusEl){
      statusEl.textContent=status;
      statusEl.className='';
      const key=normalizeStatus(status);
      if(key==='draft') statusEl.classList.add('vq-status-draft');
      else if(key==='submitted') statusEl.classList.add('vq-status-submitted');
      else if(key==='approved (admin)') statusEl.classList.add('vq-status-admin');
      else if(key==='approved (on behalf)') statusEl.classList.add('vq-status-behalf');
    }
    syncQuoteEditButton();
  };
})();
</script>


