<script id="alta-nsps-intake-navigation">
(function(){
  const link=document.querySelector('.job-alta-intake-link');
  const page=document.getElementById('alta-nsps-intake-page');
  if(!link||!page)return;
  const lockedSections=document.getElementById('altaEditLockedSections');
  if(lockedSections&&!lockedSections.children.length){
    document.querySelectorAll('#alta-view-page > .alta-detail-section').forEach(function(section){
      const copy=section.cloneNode(true);copy.classList.add('locked');
      const description=copy.querySelector('.alta-section-bar p');
      if(description)description.textContent='Submitted by the client · Read only';
      lockedSections.appendChild(copy);
    });
  }
  const search=page.querySelector('#altaRequestSearch');
  const statusFilter=page.querySelector('#altaStatusFilter');
  function filterRows(){
    const status=statusFilter?.value||'All Statuses';
    const query=(search?.value||'').trim().toLowerCase();
    page.querySelectorAll('.alta-data-row').forEach(function(row){
      const statusMatch=status==='All Statuses'||row.dataset.status===status;
      const queryMatch=!query||row.textContent.toLowerCase().includes(query);
      row.style.display=statusMatch&&queryMatch?'grid':'none';
    });
  }
  search?.addEventListener('input',filterRows);statusFilter?.addEventListener('change',filterRows);
  page.querySelectorAll('.alta-more-trigger').forEach(function(trigger){
    trigger.addEventListener('click',function(event){
      event.preventDefault();event.stopPropagation();
      const wrap=trigger.closest('.alta-more-wrap');
      const opening=!wrap.classList.contains('open');
      page.querySelectorAll('.alta-more-wrap.open').forEach(function(item){item.classList.remove('open');});
      if(opening)wrap.classList.add('open');
    });
  });
  const altaExportWrap=page.querySelector('.alta-export-menu-wrap');
  const altaExportTrigger=page.querySelector('.alta-export-trigger');
  altaExportTrigger?.addEventListener('click',function(event){event.preventDefault();event.stopPropagation();const opening=!altaExportWrap.classList.contains('open');altaExportWrap.classList.toggle('open',opening);altaExportTrigger.setAttribute('aria-expanded',String(opening));});
  document.addEventListener('click',function(){page.querySelectorAll('.alta-more-wrap.open').forEach(function(item){item.classList.remove('open');});if(altaExportWrap){altaExportWrap.classList.remove('open');altaExportTrigger?.setAttribute('aria-expanded','false');}});
  const altaEditPage=document.getElementById('alta-edit-page');
  const altaOfficeForm=altaEditPage?.querySelector('.alta-office-edit');
  const altaSaveButton=altaEditPage?.querySelector('.alta-save-office');
  let altaOfficeBaseline='';
  function altaOfficeState(){return JSON.stringify([...altaOfficeForm.querySelectorAll('input,select,textarea')].map(function(field){return field.type==='checkbox'||field.type==='radio'?field.checked:field.value;}));}
  function resetAltaOfficeDirtyState(){if(!altaOfficeForm||!altaSaveButton)return;altaOfficeBaseline=altaOfficeState();altaSaveButton.disabled=true;}
  function updateAltaOfficeDirtyState(){if(!altaOfficeForm||!altaSaveButton)return;altaSaveButton.disabled=altaOfficeState()===altaOfficeBaseline;}
  function showAltaSuccess(){document.querySelector('.alta-success-toast')?.remove();const toast=document.createElement('div');toast.className='alta-success-toast';toast.setAttribute('role','status');toast.setAttribute('aria-live','polite');toast.innerHTML='<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 2.7 2.7L16.5 9"></path></svg><span>Changes saved successfully.</span>';document.body.appendChild(toast);requestAnimationFrame(function(){toast.classList.add('show');});setTimeout(function(){toast.classList.remove('show');setTimeout(function(){toast.remove();},200);},3500);}
  altaOfficeForm?.addEventListener('input',updateAltaOfficeDirtyState);
  altaOfficeForm?.addEventListener('change',updateAltaOfficeDirtyState);
  function showAltaPage(id){
    document.querySelectorAll('.page-view').forEach(function(item){item.classList.remove('active');item.style.setProperty('display','none','important');});
    const target=document.getElementById(id);target?.classList.add('active');target?.style.setProperty('display','block','important');
    document.querySelectorAll('.side .nav,.side .subnav a').forEach(function(item){item.classList.remove('active','selected','subnav-active','job-page-selected');item.removeAttribute('aria-current');});
    link.classList.add('subnav-active','job-page-selected');link.setAttribute('aria-current','page');
    const sub=link.closest('.subnav');sub?.classList.add('open');sub?.previousElementSibling?.classList.add('open');if(id==='alta-edit-page')resetAltaOfficeDirtyState();window.scrollTo(0,0);
  }
  page.querySelectorAll('.alta-view-request').forEach(function(button){button.addEventListener('click',function(event){event.preventDefault();showAltaPage('alta-view-page');});});
  page.querySelectorAll('.alta-edit-request').forEach(function(button){button.addEventListener('click',function(event){event.preventDefault();showAltaPage('alta-edit-page');});});
  document.querySelector('#alta-view-page .alta-edit-main')?.addEventListener('click',function(){showAltaPage('alta-edit-page');});
  document.querySelector('#alta-view-page .alta-back-list')?.addEventListener('click',function(){showAltaPage('alta-nsps-intake-page');});
  document.querySelector('#alta-edit-page .alta-back-view')?.addEventListener('click',function(){showAltaPage('alta-nsps-intake-page');});
  document.querySelector('#alta-edit-page .alta-cancel-edit')?.addEventListener('click',function(){showAltaPage('alta-nsps-intake-page');});
  document.querySelector('#alta-edit-page .alta-save-office')?.addEventListener('click',function(){if(this.disabled)return;resetAltaOfficeDirtyState();showAltaPage('alta-nsps-intake-page');showAltaSuccess();});
  function openIntake(event){
    event?.preventDefault();event?.stopImmediatePropagation();
    document.querySelectorAll('.page-view').forEach(function(item){item.classList.remove('active');item.style.setProperty('display','none','important');});
    page.classList.add('active');page.style.setProperty('display','block','important');
    document.querySelectorAll('.side .nav,.side .subnav a').forEach(function(item){item.classList.remove('active','selected','subnav-active','job-page-selected');item.removeAttribute('aria-current');});
    link.classList.add('subnav-active','job-page-selected');link.setAttribute('aria-current','page');
    const sub=link.closest('.subnav');sub?.classList.add('open');sub?.previousElementSibling?.classList.add('open');
    window.scrollTo(0,0);
  }
  link.addEventListener('click',openIntake,true);
})();
</script>

