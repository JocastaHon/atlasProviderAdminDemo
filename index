<script id="action-icon-tooltips">
(function(){
  const selector='.icon-action,.jobs-icon,.jd-eye,.jd-edit,.job-client-view,.client-view-contact-edit';
  const tooltip=document.createElement('div');
  tooltip.className='action-icon-tooltip';
  tooltip.setAttribute('role','tooltip');
  document.body.appendChild(tooltip);
  let active=null;

  function fallback(button){
    if(button.matches('.delete-action'))return 'Delete';
    if(button.matches('.edit-action,.jd-edit'))return 'Edit';
    if(button.matches('.view-action,.jd-eye,.job-client-view'))return 'View';
    if(button.matches('.quote-download'))return 'Download';
    if(button.matches('.more-action,.quote-more,.survey-more-trigger,.client-menu-trigger'))return 'More actions';
    return 'Action';
  }
  function prepare(button){
    if(!button.dataset.actionTooltip){
      button.dataset.actionTooltip=button.getAttribute('title')||button.getAttribute('aria-label')||fallback(button);
      if(!button.getAttribute('aria-label'))button.setAttribute('aria-label',button.dataset.actionTooltip);
      button.removeAttribute('title');
    }
    return button.dataset.actionTooltip;
  }
  function show(button){
    active=button;
    tooltip.textContent=prepare(button);
    tooltip.classList.add('show');
    const rect=button.getBoundingClientRect();
    tooltip.style.left=(rect.left+rect.width/2)+'px';
    tooltip.style.top=(rect.top-7)+'px';
  }
  function hide(button){
    if(button&&active!==button)return;
    active=null;
    tooltip.classList.remove('show');
  }
  document.querySelectorAll(selector).forEach(prepare);
  document.addEventListener('pointerover',function(event){const button=event.target.closest(selector);if(button)show(button);});
  document.addEventListener('pointerout',function(event){const button=event.target.closest(selector);if(button&&!button.contains(event.relatedTarget))hide(button);});
  document.addEventListener('focusin',function(event){const button=event.target.closest(selector);if(button)show(button);});
  document.addEventListener('focusout',function(event){const button=event.target.closest(selector);if(button)hide(button);});
  window.addEventListener('scroll',function(){if(active)show(active);},true);
  window.addEventListener('resize',function(){if(active)show(active);});
})();
</script>

